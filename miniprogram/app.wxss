page { background: #F5F6FA; font-family: -apple-system, "PingFang SC", sans-serif; color:#333; }
.card { background:#fff; border-radius:16rpx; padding:24rpx; margin:20rpx; box-shadow:0 2rpx 12rpx rgba(0,0,0,0.05); }
.stat-row { display:flex; flex-wrap:wrap; }
.stat { flex:1; min-width:30%; text-align:center; padding:16rpx 0; }
.stat-num { font-size:40rpx; font-weight:700; color:#1082FF; }
.stat-label { font-size:24rpx; color:#888; margin-top:8rpx; }
.grid { display:flex; flex-wrap:wrap; }
.grid-item { width:25%; text-align:center; padding:20rpx 0; }
.grid-item text { display:block; font-size:24rpx; color:#333; margin-top:12rpx; }
.tag { display:inline-block; padding:4rpx 16rpx; border-radius:8rpx; font-size:22rpx; }
.tag-green { background:#E6F9EF; color:#07C06D; }
.tag-orange { background:#FFF3E0; color:#FF9B27; }
.tag-red { background:#FDEBEC; color:#E64340; }
.tag-blue { background:#E6F1FF; color:#1082FF; }
.tag-gray { background:#F0F0F0; color:#888; }
.btn-primary { background:#1082FF; color:#fff; border-radius:12rpx; margin:20rpx; padding:20rpx; border:none; font-size:28rpx; }
.muted { color:#888; font-size:24rpx; }
.row { padding:20rpx 0; border-bottom:1rpx solid #f0f0f0; }

/* 通用页面布局 */
.page { min-height:100vh; background:#F5F6FA; padding:20rpx 0 40rpx; }
.list-wrap { padding:0 20rpx; }
.list-item { margin-bottom:0; border-bottom:1rpx solid #f0f0f0; border-radius:16rpx; }
.list-item:last-child { border-bottom:none; }
.item-main { display:flex; align-items:center; justify-content:space-between; }
.item-title { font-size:28rpx; color:#333; flex:1; font-weight:500; }
.item-sub { font-size:24rpx; color:#888; margin-top:8rpx; }
.status-badge { display:inline-block; padding:4rpx 12rpx; border-radius:8rpx; font-size:22rpx; margin-left:12rpx; white-space:nowrap; }
.loading-row { text-align:center; padding:60rpx 0; }
.empty-state { text-align:center; padding:120rpx 0; }
.loading-more { text-align:center; padding:30rpx 0; }
.action-row { margin-top:12rpx; text-align:right; }

/* Tab 栏 */
.tab-bar { display:flex; margin:20rpx; padding:0; }
.tab { flex:1; text-align:center; padding:24rpx 0; font-size:28rpx; color:#888; border-bottom:4rpx solid transparent; }
.tab.active { color:#1082FF; border-bottom-color:#1082FF; font-weight:600; }

/* 设备卡 */
.device-card .device-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:20rpx; }
.device-name { font-size:32rpx; font-weight:700; color:#333; }
.risk-badge { display:inline-block; padding:4rpx 16rpx; border-radius:8rpx; font-size:22rpx; color:#fff; }
.info-grid { margin-top:8rpx; }
.info-row { display:flex; padding:12rpx 0; border-bottom:1rpx solid #f5f5f5; }
.info-row:last-child { border-bottom:none; }
.info-label { width:180rpx; color:#888; font-size:26rpx; flex-shrink:0; }
.info-val { flex:1; font-size:26rpx; color:#333; }

/* 统计栏 */
.stats-bar { margin:20rpx; }
.stats-total { text-align:center; padding-bottom:20rpx; border-bottom:1rpx solid #f0f0f0; margin-bottom:20rpx; }
.stats-total .num { font-size:56rpx; font-weight:700; color:#1082FF; display:block; }
.stats-total .lbl { font-size:24rpx; color:#888; display:block; margin-top:8rpx; }
.stats-total .mark-all { font-size:24rpx; color:#1082FF; float:right; margin-top:-60rpx; }
.stats-row { display:flex; flex-wrap:wrap; gap:16rpx; }
.stat-chip { flex:1; min-width:120rpx; text-align:center; padding:12rpx 8rpx; border:2rpx solid; border-radius:12rpx; font-size:24rpx; }

/* 消息列表 */
.msg-list { padding:0 20rpx; }
.msg-item { display:flex; align-items:flex-start; margin-bottom:0; border-bottom:1rpx solid #f0f0f0; border-radius:16rpx; padding:24rpx; }
.msg-item.unread { background:#f0f7ff; }
.msg-item.readed { opacity:0.7; }
.msg-icon { width:72rpx; height:72rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:32rpx; color:#fff; flex-shrink:0; }
.msg-body { flex:1; margin-left:20rpx; }
.msg-title { font-size:28rpx; color:#333; font-weight:500; }
.msg-content { font-size:24rpx; color:#888; margin-top:6rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.msg-time { font-size:22rpx; color:#bbb; margin-top:6rpx; }
.unread-dot { width:16rpx; height:16rpx; background:#F5222D; border-radius:50%; flex-shrink:0; margin-top:8rpx; }

/* 个人中心 */
.user-card { display:flex; align-items:center; padding:32rpx; }
.avatar-wrap { margin-right:24rpx; }
.avatar { width:100rpx; height:100rpx; border-radius:50%; background:#1082FF; color:#fff; display:flex; align-items:center; justify-content:center; font-size:40rpx; font-weight:700; }
.user-info { flex:1; }
.user-name { font-size:36rpx; font-weight:700; color:#333; }
.menu-list { margin:0 20rpx; }
.menu-item { display:flex; align-items:center; padding:28rpx 24rpx; border-bottom:1rpx solid #f0f0f0; border-radius:16rpx; margin-bottom:0; }
.menu-item:last-child { border-bottom:none; }
.menu-icon { font-size:36rpx; margin-right:16rpx; }
.menu-label { flex:1; font-size:28rpx; color:#333; }
.arrow { font-size:32rpx; color:#ccc; }
.badge { background:#F5222D; color:#fff; border-radius:20rpx; padding:2rpx 12rpx; font-size:20rpx; min-width:36rpx; text-align:center; margin-left:8rpx; }
.logout-wrap { margin:40rpx 20rpx; }
.btn-logout { background:#fff; color:#E64340; border:2rpx solid #E64340; border-radius:12rpx; font-size:28rpx; }

/* 扫码页 */
.scan-hero { text-align:center; padding:80rpx 40rpx; margin:20rpx; }
.scan-icon { font-size:120rpx; margin-bottom:24rpx; }
.scan-btn-text { font-size:36rpx; font-weight:600; color:#1082FF; }
.scan-hint { font-size:24rpx; margin-top:12rpx; }
.section { margin-top:20rpx; }
.section-header { display:flex; justify-content:space-between; padding:0 40rpx 16rpx; }
.section-title { font-size:28rpx; font-weight:600; color:#333; }

/* 表单 */
.form-panel { background:#fff; border-radius:24rpx 24rpx 0 0; padding:32rpx; }
.form-title { font-size:32rpx; font-weight:700; text-align:center; margin-bottom:32rpx; }
.form-item { margin-bottom:24rpx; }
.form-label { font-size:26rpx; color:#888; display:block; margin-bottom:8rpx; }
.form-input { border:2rpx solid #e5e5e5; border-radius:12rpx; padding:16rpx 20rpx; font-size:28rpx; width:100%; box-sizing:border-box; }
.form-textarea { border:2rpx solid #e5e5e5; border-radius:12rpx; padding:16rpx 20rpx; font-size:28rpx; width:100%; box-sizing:border-box; min-height:160rpx; }
.picker-val { border:2rpx solid #e5e5e5; border-radius:12rpx; padding:16rpx 20rpx; font-size:28rpx; color:#333; }
.flex-row { display:flex; align-items:center; }
.form-actions { display:flex; gap:20rpx; margin-top:32rpx; }
.form-actions button { flex:1; }
.btn-default { background:#f5f5f5; color:#666; border-radius:12rpx; border:none; font-size:28rpx; padding:20rpx; }
.btn-approve { background:#52C41A; color:#fff; border-radius:12rpx; border:none; font-size:28rpx; padding:20rpx; flex:1; }
.btn-reject { background:#F5222D; color:#fff; border-radius:12rpx; border:none; font-size:28rpx; padding:20rpx; flex:1; }
.btn-forward { background:#1082FF; color:#fff; border-radius:12rpx; border:none; font-size:28rpx; padding:20rpx; flex:1; }

/* 审批页 */
.info-card { margin:20rpx; }
.biz-type-tag { display:inline-block; background:#E6F1FF; color:#1082FF; border-radius:8rpx; padding:4rpx 16rpx; font-size:22rpx; margin-bottom:12rpx; }
.info-title { font-size:32rpx; font-weight:700; color:#333; margin-bottom:12rpx; }
.info-row { margin-top:8rpx; font-size:24rpx; }

/* 时间线 */
.timeline { padding:20rpx 20rpx 0; }
.timeline-item { display:flex; margin-bottom:24rpx; }
.tl-left { width:60rpx; display:flex; flex-direction:column; align-items:center; }
.tl-icon { width:48rpx; height:48rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:22rpx; flex-shrink:0; }
.tl-line { width:4rpx; flex:1; background:#e5e5e5; margin-top:8rpx; min-height:40rpx; }
.tl-right { flex:1; margin-left:16rpx; padding-bottom:8rpx; }
.tl-name { font-size:28rpx; color:#333; font-weight:500; }
.tl-name.current-node { color:#1082FF; font-weight:700; }
.tl-sub { font-size:24rpx; margin-top:4rpx; }
.tl-comment { font-size:24rpx; margin-top:6rpx; padding:8rpx 12rpx; background:#f5f5f5; border-radius:8rpx; }

/* 审批操作面板 */
.action-panel { margin:20rpx; }
.action-btns { display:flex; gap:16rpx; margin-top:24rpx; }

/* 检查记录筛选 */
.filter-bar { margin:20rpx; }
.filter-row { display:flex; align-items:center; padding:16rpx 0; border-bottom:1rpx solid #f0f0f0; }
.filter-row:last-child { border-bottom:none; }
.filter-label { width:160rpx; color:#888; font-size:26rpx; flex-shrink:0; }
.picker-val { flex:1; font-size:26rpx; color:#333; }
.source-tag { display:inline-block; padding:4rpx 12rpx; border-radius:8rpx; font-size:22rpx; color:#fff; margin-right:12rpx; white-space:nowrap; }

/* 遮罩层 */
.mask { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); z-index:100; display:flex; align-items:flex-end; }
.form-panel { width:100%; }
.action-bar { padding:20rpx; }
.btn-sm { background:#1082FF; color:#fff; border-radius:8rpx; border:none; font-size:24rpx; padding:10rpx 24rpx; display:inline-block; line-height:1; }
.tab-content { padding:0 20rpx; }
.approval-wrap { padding-bottom:40rpx; }
.pending { }
.done { }
.badge-tiny { background:#F5222D; color:#fff; border-radius:20rpx; padding:2rpx 10rpx; font-size:20rpx; margin-left:8rpx; }
