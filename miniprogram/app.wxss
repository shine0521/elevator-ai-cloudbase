page { background: #F5F6FA; font-family: -apple-system, "PingFang SC", sans-serif; color:#333; }
.card { background:#fff; border-radius:16rpx; padding:24rpx; margin:20rpx; box-shadow:0 2rpx 12rpx rgba(0,0,0,0.05); }
.stat-row { display:flex; flex-wrap:wrap; }
.stat { flex:1; min-width:30%; text-align:center; padding:16rpx 0; }
.stat-num { font-size:40rpx; font-weight:700; color:#1082FF; }
.stat-label { font-size:24rpx; color:#888; margin-top:8rpx; }
.grid { display:flex; flex-wrap:wrap; }
.grid-item { width:25%; text-align:center; padding:20rpx 0; }
.grid-item text { display:block; font-size:24rpx; color:#333; margin-top:12rpx; }
.tag { display:inline-block; padding:4rpx 16rpx; border-radius:8rpx; font-size:22rpx; }
.tag-green { background:#E6F9EF; color:#07C06D; }
.tag-orange { background:#FFF3E0; color:#FF9B27; }
.tag-red { background:#FDEBEC; color:#E64340; }
.tag-blue { background:#E6F1FF; color:#1082FF; }
.tag-gray { background:#F0F0F0; color:#888; }
.btn-primary { background:#1082FF; color:#fff; border-radius:12rpx; margin:20rpx; }
.muted { color:#888; font-size:24rpx; }
.row { padding:20rpx 0; border-bottom:1rpx solid #f0f0f0; }
