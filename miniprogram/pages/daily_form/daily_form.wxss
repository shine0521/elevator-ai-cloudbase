/* daily_form.wxss — M-04 日管控执行表单样式 */

.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

/* ══════════════════════════════
   顶部进度条
══════════════════════════════ */
.step-bar {
  display: flex;
  align-items: flex-start;
  background: #fff;
  padding: 32rpx 24rpx 24rpx;
  gap: 0;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #f0f0f0;
}

.step-dot {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  opacity: 0.4;
  transition: opacity 0.3s;
}

.step-dot.active { opacity: 1; }
.step-dot.current .dot {
  background: #1890ff;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.4);
}

.dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #d9d9d9;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.dot-label {
  font-size: 22rpx;
  color: #666;
  text-align: center;
}

/* ══════════════════════════════
   步骤区块
══════════════════════════════ */
.step-section {
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  padding-bottom: 16rpx;
  border-bottom: 4rpx solid #1890ff;
  display: inline-block;
}

.section-title.sub {
  font-size: 28rpx;
  font-weight: 500;
  border-bottom: none;
  color: #666;
  padding-bottom: 0;
  margin-top: 16rpx;
}

/* ══════════════════════════════
   卡片
══════════════════════════════ */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.device-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.status-tag {
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #fff;
}

.status-tag.success { background: #52c41a; }

.card-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-size: 28rpx;
}

.label { color: #999; width: 140rpx; flex-shrink: 0; }
.val { color: #333; flex: 1; }

/* ══════════════════════════════
   设备列表
══════════════════════════════ */
.btn-group {
  display: flex;
  gap: 16rpx;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.device-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  position: relative;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.device-item.selected {
  border-color: #1890ff;
  background: #e6f7ff;
}

.di-name { font-size: 30rpx; font-weight: 600; color: #333; }
.di-code { font-size: 26rpx; color: #666; }
.di-loc { font-size: 24rpx; color: #999; }
.di-check {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  color: #1890ff;
  font-size: 32rpx;
  font-weight: 700;
}

/* ══════════════════════════════
   表单项
══════════════════════════════ */
.form-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-label.required::after {
  content: ' *';
  color: #ff4d4f;
}

.form-textarea {
  width: 100%;
  min-height: 80rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.picker-val {
  font-size: 28rpx;
  color: #333;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  min-height: 60rpx;
}

/* ══════════════════════════════
   模板选择
══════════════════════════════ */
.template-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tpl-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tpl-item.selected {
  border-color: #1890ff;
  background: #e6f7ff;
}

.tpl-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.tpl-desc {
  font-size: 26rpx;
  color: #666;
}

.tpl-meta {
  font-size: 24rpx;
  color: #999;
}

.field-preview { margin-top: 8rpx; }

.field-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.chip {
  padding: 8rpx 20rpx;
  background: #f0f5ff;
  color: #1890ff;
  border-radius: 24rpx;
  font-size: 24rpx;
  border: 1rpx solid #d9e8ff;
}

/* ══════════════════════════════
   步骤3：逐项填写
══════════════════════════════ */
.info-strip {
  background: #1890ff;
  color: #fff;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.strip-sep { opacity: 0.5; }

.toolbar-row {
  display: flex;
  justify-content: flex-end;
}

.field-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.field-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 6rpx solid #d9d9d9;
  transition: border-color 0.2s;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.field-item.field-pass { border-left-color: #52c41a; }
.field-item.field-fail { border-left-color: #ff4d4f; }

.fi-header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.fi-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #1890ff;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.fi-title {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.fi-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.fi-required { color: #ff4d4f; margin-left: 4rpx; }

.fi-standard {
  font-size: 24rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.fi-result {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  cursor: pointer;
  background: #f0f0f0;
  color: #666;
  white-space: nowrap;
  transition: all 0.2s;
  flex-shrink: 0;
}

.fi-result.pass { background: #f6ffed; color: #52c41a; }
.fi-result.fail { background: #fff2f0; color: #ff4d4f; }

.fi-ai-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
}

.ai-label { color: #999; }
.ai-val { color: #1890ff; font-weight: 600; }

/* 字段输入控件 */
.fi-control { width: 100%; }

.field-input {
  width: 100%;
  height: 72rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fafafa;
}

.field-input:focus { border-color: #1890ff; background: #fff; }

.num-input { inputmode: 'decimal'; }

.field-textarea {
  width: 100%;
  min-height: 80rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fafafa;
}

.picker-btn {
  height: 72rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  background: #fafafa;
}

.checkbox-row { display: flex; flex-direction: column; gap: 12rpx; }
.checkbox-label { display: flex; align-items: center; gap: 10rpx; font-size: 28rpx; color: #333; }
.radio-label { display: flex; align-items: center; gap: 10rpx; font-size: 28rpx; color: #333; margin-right: 32rpx; }

.photo-wrap { display: flex; flex-direction: column; gap: 12rpx; }
.camera-btn {
  padding: 20rpx;
  background: #e6f7ff;
  color: #1890ff;
  border-radius: 10rpx;
  font-size: 28rpx;
  text-align: center;
  border: 2rpx dashed #91d5ff;
}

.photo-preview {
  width: 200rpx;
  height: 150rpx;
  border-radius: 8rpx;
}

.photo-id { font-size: 24rpx; color: #999; }
.photo-tip { font-size: 24rpx; color: #52c41a; }

.file-wrap { display: flex; flex-direction: column; gap: 12rpx; }
.file-name { font-size: 28rpx; color: #333; }

.readonly-val {
  font-size: 28rpx;
  color: #999;
  background: #f5f5f5;
  padding: 16rpx;
  border-radius: 8rpx;
  text-align: center;
}

/* ══════════════════════════════
   步骤4：签名
══════════════════════════════ */
.signature-preview {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  min-height: 300rpx;
  border: 2rpx dashed #d9d9d9;
}

.sig-img {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
}

.sig-text { font-size: 28rpx; color: #666; }
.sig-tip { font-size: 28rpx; font-weight: 600; }
.sig-tip.success { color: #52c41a; }

.signature-empty {
  background: #fff;
  border-radius: 16rpx;
  padding: 80rpx;
  text-align: center;
}

.sig-placeholder {
  font-size: 28rpx;
  color: #bbb;
}

.sig-desc {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 8rpx;
}

/* ══════════════════════════════
   步骤5：结果页
══════════════════════════════ */
.result-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
  gap: 32rpx;
}

.result-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #f6ffed;
  border: 6rpx solid #52c41a;
  color: #52c41a;
  font-size: 80rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.result-sub {
  font-size: 28rpx;
  color: #999;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  max-width: 600rpx;
  margin-top: 24rpx;
}

/* ══════════════════════════════
   底部操作栏
══════════════════════════════ */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.bar-left { flex: 1; }

/* ══════════════════════════════
   按钮
══════════════════════════════ */
.btn {
  padding: 20rpx 40rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  line-height: 1.2;
  background: #1890ff;
  color: #fff;
}

.btn::after { border: none; }

.btn-primary { background: #1890ff; color: #fff; }
.btn-submit { background: linear-gradient(135deg, #1890ff, #096dd9); color: #fff; }
.btn-outline {
  background: #fff;
  color: #1890ff;
  border: 2rpx solid #1890ff;
}
.btn-ghost { background: transparent; color: #666; font-size: 28rpx; }
.btn-sm { padding: 16rpx 32rpx; font-size: 26rpx; }

.btn[loading] { opacity: 0.6; }

/* ══════════════════════════════
   状态 & 空状态
══════════════════════════════ */
.readonly-tip {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #faad14;
  color: #fff;
  text-align: center;
  padding: 12rpx;
  font-size: 24rpx;
  z-index: 200;
}

.empty-field, .empty-small {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

.loading-row {
  text-align: center;
  padding: 40rpx;
  color: #1890ff;
  font-size: 28rpx;
}
