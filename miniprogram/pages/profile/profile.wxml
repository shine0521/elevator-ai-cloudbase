<view class="page">
  <!-- 用户信息卡 -->
  <view class="user-card card">
    <view class="avatar-wrap">
      <view class="avatar">{{user.name ? user.name.charAt(0) : '?'}}</view>
    </view>
    <view class="user-info">
      <view class="user-name">{{user.name || '未登录'}}</view>
      <view class="muted">{{user.role || '未知角色'}}</view>
      <view class="muted">{{user.email || ''}}</view>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-list">
    <view class="menu-item card" bindtap="goMessage">
      <text class="menu-icon">🔔</text>
      <text class="menu-label">我的消息</text>
      <text class="badge" wx:if="{{unreadCount>0}}">{{unreadCount>99?'99+':unreadCount}}</text>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item card" bindtap="goApproval">
      <text class="menu-icon">📋</text>
      <text class="menu-label">审批待办</text>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item card" bindtap="goRecord">
      <text class="menu-icon">📊</text>
      <text class="menu-label">检查记录</text>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item card" bindtap="goSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-label">系统设置</text>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item card">
      <text class="menu-icon">📱</text>
      <text class="menu-label">关于版本</text>
      <text class="muted">v1.0.0</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-wrap">
    <button class="btn-logout" bindtap="logout">退出登录</button>
  </view>
</view>
