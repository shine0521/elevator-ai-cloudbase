<view class="page">
  <!-- 顶部按钮 -->
  <view class="action-bar">
    <button class="btn-primary" bindtap="showNewForm">新建应急事件</button>
  </view>

  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="empty-state"><text class="muted">加载中...</text></view>
  <view wx:elif="{{list.length===0}}" class="empty-state"><text class="muted">暂无应急事件</text></view>

  <!-- 事件列表 -->
  <view wx:else class="list-wrap">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="list-item card"
      bindtap="goDetail"
      data-id="{{item.id}}"
    >
      <view class="item-main">
        <view class="item-title">{{item.event_title || item.alarm_type || '应急事件'}}{{item.id ? ' #' + item.id : ''}}</view>
        <view
          class="status-badge"
          style="background:{{statusCfg(item.status).color}};color:#fff"
        >{{statusCfg(item.status).label}}</view>
      </view>
      <view class="item-sub muted">
        <text wx:if="{{item.device_name}}">设备：{{item.device_name}}</text>
        <text wx:if="{{item.trapped_count && item.trapped_count>0}}"> | 被困人数：{{item.trapped_count}}</text>
        <text wx:if="{{item.create_time}}"> | {{item.create_time}}</text>
      </view>
      <view wx:if="{{item.status!=='completed'}}" class="action-row">
        <button
          class="btn-sm"
          size="mini"
          data-id="{{item.id}}"
          data-status="{{item.status}}"
          bindtap="updateStatus"
        >推进状态 ›</button>
      </view>
    </view>
  </view>

  <!-- ====== 新建表单弹层 ====== -->
  <view wx:if="{{showForm}}" class="mask" catchtap="hideForm">
    <view class="form-panel" catchtap="stopProp">
      <view class="form-title">新建应急事件</view>

      <!-- 报警类型 -->
      <view class="form-item">
        <text class="form-label">报警类型 *</text>
        <picker mode="selector" range="{{['困人报警','故障报警','物联网报警','人工报警']}}" bindchange="bindAlarmType">
          <view class="picker-val">{{form.alarm_type || '请选择'}}</view>
        </picker>
      </view>

      <!-- 设备 -->
      <view class="form-item">
        <text class="form-label">关联设备</text>
        <view class="flex-row">
          <input class="form-input" placeholder="设备名称/编号" value="{{form.device_name}}" bindinput="inputDeviceName" />
          <button class="btn-sm" bindtap="scanDevice" style="margin-left:8rpx">扫码</button>
        </view>
      </view>

      <!-- 被困人数 -->
      <view class="form-item">
        <text class="form-label">被困人数</text>
        <input class="form-input" type="number" placeholder="请输入" value="{{form.trapped_count}}" bindinput="inputTrapped" />
      </view>

      <!-- 描述 -->
      <view class="form-item">
        <text class="form-label">情况描述 *</text>
        <textarea class="form-textarea" placeholder="请详细描述情况（至少5字）" value="{{form.description}}" bindinput="inputDesc" />
      </view>

      <!-- 联系人 -->
      <view class="form-item">
        <text class="form-label">紧急联系人</text>
        <input class="form-input" placeholder="姓名" value="{{form.contact_name}}" bindinput="inputContact" />
      </view>
      <view class="form-item">
        <text class="form-label">联系电话</text>
        <input class="form-input" type="number" placeholder="手机号" value="{{form.contact_phone}}" bindinput="inputPhone" />
      </view>

      <!-- 操作 -->
      <view class="form-actions">
        <button class="btn-default" bindtap="hideForm">取消</button>
        <button class="btn-primary" bindtap="submitForm" loading="{{submitting}}">提交</button>
      </view>
    </view>
  </view>
</view>
