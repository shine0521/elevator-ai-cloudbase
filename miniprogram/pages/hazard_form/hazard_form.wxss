.page { min-height: 100vh; background: #F5F6FA; padding-bottom: 120rpx; }
.section-title { font-size: 28rpx; color: #888; padding: 20rpx 32rpx 10rpx; }
.card { background: #fff; margin: 0 32rpx 20rpx; border-radius: 12rpx; padding: 24rpx; }
.section-title + .card { margin-top: 0; }

/* 步骤条 */
.steps-bar {
  display: flex; align-items: center; justify-content: center;
  background: #fff; padding: 32rpx 48rpx; margin-bottom: 24rpx;
}
.step-item { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.step-num {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #ddd; color: #fff; font-size: 24rpx;
  display: flex; align-items: center; justify-content: center;
}
.step-item.active .step-num { background: #1082FF; }
.step-label { font-size: 22rpx; color: #888; }
.step-item.active .step-label { color: #1082FF; }
.step-line { flex: 1; height: 2rpx; background: #ddd; margin: 0 16rpx; margin-bottom: 30rpx; }
.step-line.active { background: #1082FF; }

/* 表单 */
.step-content { padding: 0 32rpx 120rpx; }
.form-group { margin-bottom: 32rpx; }
.form-label { font-size: 28rpx; color: #333; font-weight: 500; margin-bottom: 12rpx; }
.input {
  background: #fff; border: 1rpx solid #E5E5E5; border-radius: 12rpx;
  padding: 20rpx 24rpx; font-size: 30rpx; width: 100%; box-sizing: border-box;
}
.textarea {
  background: #fff; border: 1rpx solid #E5E5E5; border-radius: 12rpx;
  padding: 20rpx 24rpx; font-size: 28rpx; width: 100%; box-sizing: border-box;
  min-height: 160rpx;
}
.picker-show {
  background: #fff; border: 1rpx solid #E5E5E5; border-radius: 12rpx;
  padding: 20rpx 24rpx; font-size: 30rpx; color: #333;
}
.search-row { display: flex; gap: 16rpx; }
.btn-scan {
  background: #1082FF; color: #fff; border-radius: 44rpx;
  font-size: 30rpx; padding: 24rpx; width: 100%; border: none;
}
.btn-sm {
  background: #1082FF; color: #fff; border-radius: 12rpx;
  font-size: 26rpx; padding: 0 24rpx; border: none; white-space: nowrap;
}
.selected-device {
  background: #E6F7FF; border: 1rpx solid #1082FF; border-radius: 12rpx;
  padding: 16rpx 24rpx; color: #1082FF; font-size: 28rpx; margin-top: 16rpx;
}
.device-item {
  background: #fff; border-bottom: 1rpx solid #eee; padding: 16rpx 24rpx; font-size: 28rpx;
}
.user-item {
  background: #fff; border: 1rpx solid #E5E5E5; border-radius: 8rpx;
  padding: 12rpx 20rpx; font-size: 26rpx; margin-top: 8rpx; color: #1082FF;
}

/* LSEB */
.lseb-intro { font-size: 26rpx; color: #888; margin-bottom: 24rpx; text-align: center; }
.lseb-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; margin-bottom: 24rpx; }
.lseb-item { background: #F5F6FA; border-radius: 12rpx; padding: 20rpx 0; text-align: center; }
.lseb-val { display: block; font-size: 40rpx; font-weight: 700; color: #1082FF; }
.lseb-label { display: block; font-size: 22rpx; color: #888; margin-top: 6rpx; }
.risk-card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-top: 16rpx; }
.risk-calc { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; flex-wrap: wrap; }
.rc-label { font-size: 28rpx; color: #333; }
.rc-val { font-size: 28rpx; color: #333; }
.rc-total { font-size: 36rpx; font-weight: 700; padding: 4rpx 16rpx; border-radius: 8rpx; }
.risk-bands { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.risk-summary { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.critical-warn { background: #FFF1F0; border: 1rpx solid #FF6600; border-radius: 8rpx; padding: 16rpx; color: #CF1322; font-size: 28rpx; margin-top: 12rpx; }
.mt20 { margin-top: 20rpx; }

/* 风险颜色 */
.risk-badge { display: inline-block; padding: 4rpx 16rpx; border-radius: 6rpx; font-size: 26rpx; }
.risk-critical { background: #FFF1F0; color: #CF1322; }
.risk-major    { background: #FFF7E6; color: #D46B08; }
.risk-general  { background: #FFFBE6; color: #7CB305; }
.risk-low      { background: #F6FFED; color: #389E0D; }

/* 照片 */
.photo-row { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 8rpx 0; }
.photo-wrap { position: relative; }
.photo-thumb { width: 160rpx; height: 160rpx; border-radius: 12rpx; }
.photo-del {
  position: absolute; top: -8rpx; right: -8rpx;
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: rgba(0,0,0,.5); color: #fff; font-size: 22rpx;
  display: flex; align-items: center; justify-content: center;
}
.photo-add {
  width: 160rpx; height: 160rpx; border-radius: 12rpx;
  border: 2rpx dashed #ccc; color: #ccc; font-size: 60rpx;
  display: flex; align-items: center; justify-content: center;
}

/* 确认卡片 */
.confirm-card { background: #fff; border-radius: 12rpx; padding: 24rpx; }
.confirm-title { font-size: 32rpx; font-weight: 600; color: #333; margin-bottom: 20rpx; }
.info-row { display: flex; padding: 12rpx 0; border-bottom: 1rpx solid #F5F6FA; gap: 16rpx; }
.info-row:last-child { border-bottom: none; }
.label { font-size: 28rpx; color: #888; width: 160rpx; flex-shrink: 0; }
.value { font-size: 28rpx; color: #333; flex: 1; }
.value.multi { word-break: break-all; }

/* 底部栏 */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,.06);
  display: flex; gap: 20rpx;
}
.btn-primary {
  flex: 1; background: #1082FF; color: #fff; border-radius: 44rpx;
  font-size: 32rpx; font-weight: 600; padding: 24rpx 0; border: none;
}
.btn-default {
  flex: 1; background: #fff; color: #1082FF; border-radius: 44rpx;
  font-size: 32rpx; font-weight: 600; padding: 24rpx 0; border: 1rpx solid #1082FF;
}
.warn-tip { color: #CF1322; font-size: 26rpx; margin-left: 16rpx; }
