<view class="page">
  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="loading-row">
    <text class="muted">加载中...</text>
  </view>

  <!-- 空态 -->
  <view wx:elif="{{list.length===0}}" class="empty-state">
    <text class="muted">暂无数据</text>
  </view>

  <!-- 列表 -->
  <view wx:else class="list-wrap">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="list-item card"
      bindtap="goDetail"
      data-item="{{item}}"
      data-type="{{type}}"
    >
      <!-- 主行 -->
      <view class="item-main">
        <view class="item-title">{{rowLabel(item)}}</view>
        <view class="status-badge" style="background:{{statusColor(statusText(item))}};color:#fff">
          {{statusText(item)}}
        </view>
      </view>

      <!-- 副行信息 -->
      <view class="item-sub">
        <text wx:if="{{item.create_time}}">{{item.create_time}}</text>
        <text wx:elif="{{item.created_at}}">{{item.created_at}}</text>
        <text wx:if="{{item.inspection_date}}"> | {{item.inspection_date}}</text>
        <text wx:if="{{item.inspector_name}}"> | {{item.inspector_name}}</text>
        <text wx:if="{{item.location}}"> | {{item.location}}</text>
        <text wx:if="{{item.risk_level}}"> | 风险：{{item.risk_level}}</text>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{loadingMore}}" class="loading-more">
      <text class="muted">加载中...</text>
    </view>
    <view wx:elif="{{!hasMore && list.length>0}}" class="loading-more">
      <text class="muted">— 没有更多了 —</text>
    </view>
  </view>
</view>
