<view class="card">
  <view wx:if="{{loading}}" class="muted">加载中...</view>
  <view wx:elif="{{list.length===0}}" class="muted">暂无数据</view>
  <view wx:for="{{list}}" wx:key="id" class="row">{{item.device_name || item.inspection_no || item.event_no || item.order_no || item.hazard_type || item.month_no || '记录'}}</view>
</view>
