<view class="login">
  <view class="logo">特安助</view>
  <view class="sub">特种设备电梯安全管理</view>

  <button class="btn-primary wechat-btn" bindtap="wechatLogin" wx:if="{{mode==='wechat'}}">微信一键登录</button>

  <view wx:if="{{mode==='account'}}">
    <view class="field"><input placeholder="邮箱" value="{{email}}" bindinput="onEmail" /></view>
    <view class="field"><input placeholder="密码" password value="{{password}}" bindinput="onPwd" /></view>
    <button class="btn-primary" bindtap="accountLogin">登录</button>
    <view class="muted tip">{{wechatTip}}</view>
  </view>

  <view class="switch" bindtap="switchMode" data-mode="{{mode==='wechat'?'account':'wechat'}}">
    {{mode==='wechat' ? '使用账号密码登录' : '使用微信登录'}}
  </view>
</view>
