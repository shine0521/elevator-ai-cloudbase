.page { min-height: 100vh; background: #F5F6FA; }
.tabs-bar {
  white-space: nowrap;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  padding: 0 16rpx;
}
.tab-item {
  display: inline-block;
  padding: 24rpx 24rpx;
  font-size: 28rpx;
  color: #888;
  position: relative;
}
.tab-item.active {
  color: #1082FF;
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0; left: 50%; transform: translateX(-50%);
  width: 48rpx; height: 4rpx;
  background: #1082FF;
  border-radius: 2rpx;
}
.list-wrap { padding: 24rpx; }
.card {
  background: #fff; border-radius: 12rpx;
  padding: 24rpx; margin-bottom: 20rpx;
}
.wo-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 8rpx; }
.wo-device { font-size: 26rpx; color: #888; margin-bottom: 14rpx; }
.wo-tags { display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx; }
.muted { color: #888; font-size: 26rpx; }
.center { text-align: center; padding: 60rpx 0; }

/* 风险标签 */
.risk-badge { display: inline-block; padding: 2rpx 12rpx; border-radius: 4rpx; font-size: 24rpx; }
.risk-critical { background: #FFF1F0; color: #CF1322; }
.risk-major    { background: #FFF7E6; color: #D46B08; }
.risk-general  { background: #FFFBE6; color: #7CB305; }
.risk-low      { background: #F6FFED; color: #389E0D; }

/* 状态标签 */
.tag { display: inline-block; padding: 2rpx 12rpx; border-radius: 4rpx; font-size: 24rpx; }
.tag-warn    { background: #FFF7E6; color: #FF6600; }
.tag-info    { background: #E6F7FF; color: #1082FF; }
.tag-primary { background: #F6FFED; color: #09B44A; }
.tag-gray    { background: #F5F5F5; color: #888; }

/* 时间线 */
.timeline {
  display: flex; align-items: center;
  padding: 0 8rpx; margin-bottom: 8rpx;
}
.tl-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: #ddd; flex-shrink: 0;
}
.tl-dot.done { background: #1082FF; }
.tl-line {
  flex: 1; height: 3rpx;
  background: #ddd;
}
.tl-line.done { background: #1082FF; }
.timeline-labels {
  display: flex; justify-content: space-between;
  font-size: 22rpx; color: #888; padding: 0 2rpx;
}
