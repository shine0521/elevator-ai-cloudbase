<%- include('partials/head') %>
<div class="shell">
<%- include('partials/sidebar', {user: user}) %>
<main class="main">
  <%- include('partials/topbar', {user: user, title: '模板研究'}) %>
  <div class="content">
    <div class="page-hd">
      <div>
        <div class="pt">模板研究与提炼</div>
        <div class="pd">由专家发起研究任务，AI 辅助生成模板建议，专家修订后发布为正式判别模板</div>
      </div>
      <button class="btn btn-p" onclick="showCreateForm()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
        新建研究任务
      </button>
    </div>

    <div class="card">
      <div class="card-h"><div class="ct"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/></svg>研究任务</div></div>
      <div class="card-b">
        <div id="createForm" class="hide mb">
          <div class="grid-2">
            <div class="field"><label>任务名称 <span style="color:var(--danger)">*</span></label><input class="inp" id="task_name" type="text" placeholder="例如：电梯半月维保合规审核模板"></div>
            <div class="field"><label>设计标准 / 备注</label><input class="inp" id="standards" type="text" placeholder="可填写适用的设计标准"></div>
          </div>
          <div class="field"><label>任务描述</label><textarea class="txta" id="task_description" rows="2" placeholder="研究任务详细描述..."></textarea></div>
          <div class="field">
            <label>关联法规条款（可选，用于 AI 建议依据）</label>
            <select class="sel" id="regSelect" onchange="loadClauses()"><option value="">选择法规…</option></select>
            <div id="clauseBox" class="clause-box mt-s"></div>
          </div>
          <div class="flex gap">
            <button class="btn btn-p" onclick="createTask()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H7v8M7 3v5h8"/></svg>
              创建任务
            </button>
            <button class="btn btn-ghost" onclick="hideCreateForm()">取消</button>
          </div>
        </div>

        <div class="tbl-wrap">
          <table class="tbl">
            <thead>
              <tr><th style="width:54px">ID</th><th>任务名称</th><th style="width:104px">状态</th><th style="width:78px">AI建议</th><th style="width:90px">专家</th><th style="width:140px">创建时间</th><th style="width:84px">操作</th></tr>
            </thead>
            <tbody id="tableBody">
              <tr><td colspan="7" class="empty" style="padding:40px">加载中...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</main>
</div>

<div class="overlay" id="detailModal">
  <div class="modal" style="max-width:820px">
    <div class="modal-h"><span class="mt">研究任务详情</span><button class="x" onclick="App.closeModal('detailModal')">✕</button></div>
    <div class="modal-b" id="modalBody"><div class="empty" style="padding:40px"><span class="spinner"></span></div></div>
    <div class="modal-f" id="detailFoot"></div>
  </div>
</div>

<script>
(function(){
  function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
  function pad(n){return String(n).padStart(2,'0');}
  // BUG-04：统一走 App.fmtDT（后端 UTC → 本地）
  function fmtDT(v){ return App.fmtDT(v); }
  function stMap(s){return s==='published'?['tag ok','已发布']:s==='ai_generated'?['tag blue','AI已生成']:s==='expert_review'?['tag purple','专家审阅']:s==='failed'?['tag ng','失败']:['tag gray','待启动'];}

  // 专家审阅状态：suggestionId → { fields:{idx:{action,value}}, rules:{...} }
  var reviewState={ sid:null, ai:null, fields:{}, rules:{} };

  function loadRegulations(){
    App.api('/api/regulations').then(function(d){
      var sel=document.getElementById('regSelect');
      sel.innerHTML='<option value="">选择法规…</option>';
      (d.data||[]).forEach(function(r){ sel.innerHTML+='<option value="'+r.id+'">'+esc(r.name)+'</option>'; });
    });
  }
  function loadClauses(){
    var rid=document.getElementById('regSelect').value;
    var box=document.getElementById('clauseBox');
    if(!rid){ box.innerHTML=''; return; }
    box.innerHTML='<div class="empty" style="padding:14px">加载条款…</div>';
    App.api('/api/regulations/'+rid+'/clauses').then(function(d){
      // 后端同时返回 clauses 与 data，两者取其一（旧版只读 d.data 导致条款永远为空）
      var cls=d.clauses||d.data||[];
      if(!cls.length){ box.innerHTML='<div class="empty" style="padding:14px">该法规暂无条款</div>'; return; }
      box.innerHTML=cls.map(function(c){
        return '<label class="chk"><input type="checkbox" value="'+c.id+'" data-text="'+esc(c.content).replace(/"/g,'&quot;')+'"> <span>'+esc(c.clause_number)+' '+esc(c.title||'')+'</span></label>';
      }).join('');
    }).catch(function(){ box.innerHTML='<div class="empty" style="padding:14px;color:var(--danger)">条款加载失败</div>'; });
  }

  function loadTasks(){
    var tbody=document.getElementById('tableBody');
    tbody.innerHTML='<tr><td colspan="7" class="empty" style="padding:40px">加载中...</td></tr>';
    App.api('/api/template-research').then(function(d){
      var data=d.data||[];
      if(data.length===0){ tbody.innerHTML='<tr><td colspan="7" class="empty" style="padding:40px">暂无研究任务</td></tr>'; return; }
      tbody.innerHTML=data.map(function(t){
        var sm=stMap(t.status);
        var ts=App.fmtDT(t.created_at_iso||t.created_at);
        return '<tr>'+
               '<td class="mono" style="color:var(--primary-d)">#'+t.id+'</td>'+
               '<td class="cell-main"><b>'+esc(t.task_name||'')+'</b>'+(t.task_description?'<div class="sub">'+esc(t.task_description)+'</div>':'')+'</td>'+
               '<td><span class="tag '+sm[0]+'">'+sm[1]+'</span></td>'+
               '<td><span class="mono">'+esc(t.suggestion_count||0)+'</span></td>'+
               '<td class="muted">'+esc(t.expert_name||'--')+'</td>'+
               '<td class="muted">'+ts+'</td>'+
               '<td><button class="btn btn-o btn-sm" onclick="showDetail('+t.id+')">详情</button></td></tr>';
      }).join('');
    }).catch(function(){ tbody.innerHTML='<tr><td colspan="7" class="empty" style="padding:40px;color:var(--danger)">加载失败</td></tr>'; });
  }

  function showDetail(id){
    App.openModal('detailModal');
    document.getElementById('modalBody').innerHTML='<div class="empty" style="padding:40px"><span class="spinner"></span></div>';
    document.getElementById('detailFoot').innerHTML='';
    App.api('/api/template-research/'+id).then(function(d){
      var t=d.data||{};
      var sm=stMap(t.status);
      var suggestions=t.suggestions||[];
      // 取最新一条建议作为可审阅对象（TR-03）
      var latest=suggestions[0]||null;
      reviewState={ sid:null, ai:null, fields:{}, rules:{} };

      var sugHtml=suggestions.map(function(s){
        var sug={}; try{ sug=JSON.parse(s.ai_output_json||'{}'); }catch(e){ sug={}; }
        var fin=null; try{ fin=s.final_output_json?JSON.parse(s.final_output_json):null; }catch(e){ fin=null; }
        var diff=null; try{ diff=s.diff_summary?JSON.parse(s.diff_summary):null; }catch(e){ diff=null; }
        var fCount=(sug.fields||[]).length, rCount=(sug.rules||[]).length;
        var diffHtml='';
        if(diff){
          // TR-04：展示大模型原始建议与专家修改的差异
          diffHtml='<div class="alert info mt-s" style="margin-bottom:0"><div class="t-xs">'+
            '<b>专家审阅差异留痕</b>（'+esc(diff.reviewedBy||'')+' · '+App.fmtDT(diff.reviewedAt)+'）<br>'+
            '字段：接受 '+diff.fields.accepted+' · 修改 '+diff.fields.modified+' · 拒绝 '+diff.fields.rejected+' · 新增 '+diff.fields.added+'（AI '+diff.fields.ai+' → 定稿 '+diff.fields.final+'）<br>'+
            '规则：接受 '+diff.rules.accepted+' · 修改 '+diff.rules.modified+' · 拒绝 '+diff.rules.rejected+' · 新增 '+diff.rules.added+'（AI '+diff.rules.ai+' → 定稿 '+diff.rules.final+'）'+
            '</div></div>';
        }
        return '<div class="suggest-card">'+
          '<div class="flex between mb-s"><div><b>'+esc((fin&&fin.template_name)||sug.template_name||('建议#'+s.id))+'</b> <span class="tag '+(s.model_name&&s.model_name.indexOf('规则')>=0?'gray':'blue')+'">'+(esc(s.model_name)||'AI')+'</span>'+(fin?' <span class="tag ok">已定稿</span>':'')+'</div><span class="tag '+(s.status==='approved'?'ok':s.status==='modified'?'purple':'mb')+'">'+esc(s.status)+'</span></div>'+
          (sug.template_code?'<div class="sub mono">'+esc(sug.template_code)+'</div>':'')+
          '<div class="sub">字段 '+fCount+' 项 · 规则 '+rCount+' 条</div>'+
          (sug.output_template?'<div class="rd">输出模板：'+esc(sug.output_template)+'</div>':'')+
          diffHtml+
          '</div>';
      }).join('') || '<div class="muted">暂无 AI 建议，请先生成</div>';

      var reviewHtml='';
      if(latest && (t.status==='ai_generated'||t.status==='expert_review')){
        reviewHtml=buildReviewPanel(latest);
      }

      document.getElementById('modalBody').innerHTML=
        '<div class="kv mb"><span class="k">ID</span><span class="v">#'+t.id+'</span>'+
          '<span class="k">状态</span><span class="v"><span class="tag '+sm[0]+'">'+sm[1]+'</span></span>'+
          '<span class="k">专家</span><span class="v">'+esc(t.expert_name||'--')+'</span>'+
          '<span class="k">创建时间</span><span class="v">'+fmtDT(t.created_at_iso||t.created_at)+'</span></div>'+
        '<div class="field"><label>任务名称</label><div>'+esc(t.task_name||'')+'</div></div>'+
        (t.task_description?'<div class="field"><label>描述</label><div class="muted">'+esc(t.task_description)+'</div></div>':'')+
        '<div class="card-t mb-s mt" style="font-size:14px">AI 模板建议</div>'+
        '<div id="sugList">'+sugHtml+'</div>'+
        reviewHtml+
        (t.status==='ai_generated'||t.status==='expert_review'?'<div class="field mt"><label>专家总体意见</label><textarea class="txta" id="expertMod" rows="2" placeholder="对 AI 建议的修订意见（可选）"></textarea></div>':'');

      var foot=document.getElementById('detailFoot');
      var btns='';
      if(t.status==='draft') btns+='<button class="btn btn-p" onclick="genSuggest('+t.id+')">生成 AI 建议</button>';
      if(t.status==='ai_generated'||t.status==='expert_review'){
        btns+='<button class="btn btn-p" onclick="genSuggest('+t.id+')">重新生成</button>';
        if(latest) btns+='<button class="btn btn-s" onclick="submitReview('+t.id+','+latest.id+')">提交审阅定稿</button>';
        btns+='<button class="btn btn-o" onclick="saveModify('+t.id+')">仅保存意见</button>';
        btns+='<button class="btn btn-d" onclick="publishTpl('+t.id+')">采纳并发布</button>';
      }
      if(t.status==='published') btns+='<span class="tag ok">已发布为模板</span>';
      btns+='<button class="btn btn-ghost" onclick="App.closeModal(\'detailModal\')">关闭</button>';
      foot.innerHTML=btns;
    }).catch(function(){ document.getElementById('modalBody').innerHTML='<div class="empty" style="padding:30px;color:var(--danger)">加载失败</div>'; });
  }

  /**
   * TR-03：专家逐条审阅面板
   * 每一条 AI 建议的字段/规则都可以接受 / 拒绝 / 修改，提交后形成专家定稿，
   * 并由后端记录与 AI 原始建议的逐项差异（TR-04）。
   */
  function buildReviewPanel(s){
    var ai={}; try{ ai=JSON.parse(s.ai_output_json||'{}'); }catch(e){ ai={}; }
    // 已有定稿时以定稿为初始展示
    reviewState.sid=s.id;
    reviewState.ai=ai;
    reviewState.fields={};
    reviewState.rules={};

    var fields=Array.isArray(ai.fields)?ai.fields:[];
    var rules=Array.isArray(ai.rules)?ai.rules:[];

    function row(kind,i,title,sub){
      return '<div class="flex gap-s center wrap mb-s" style="padding:8px;border:1px solid var(--border-2);border-radius:8px">'+
        '<div style="flex:1;min-width:220px"><b class="t-sm">'+esc(title)+'</b>'+(sub?'<div class="sub t-xs">'+esc(sub)+'</div>':'')+'</div>'+
        '<select class="sel" style="width:110px" onchange="setDecision(\''+kind+'\','+i+',this.value)">'+
          '<option value="accept">接受</option>'+
          '<option value="modify">修改</option>'+
          '<option value="reject">拒绝</option>'+
        '</select>'+
        '<input class="inp" style="width:190px" type="text" placeholder="审阅备注（可选）" onchange="setNote(\''+kind+'\','+i+',this.value)">'+
        '<div id="mod-'+kind+'-'+i+'" style="flex-basis:100%" class="hide"></div>'+
      '</div>';
    }

    var fieldRows=fields.map(function(f,i){
      return row('fields',i,(f.label||f.name||('字段'+(i+1))),
        (f.name||'')+' · '+(f.type||'text')+(f.required?' · 必填':'')+(f.options&&f.options.length?' · 选项: '+App.parseOptions(f.options).join('/'):''));
    }).join('')||'<div class="muted t-xs">AI 未产出字段建议</div>';

    var ruleRows=rules.map(function(r,i){
      return row('rules',i,(r.condition||('规则'+(i+1))),
        (r.result?'结果: '+r.result:'')+(r.message?' · '+r.message:'')+(r.severity?' · '+r.severity:''));
    }).join('')||'<div class="muted t-xs">AI 未产出规则建议</div>';

    return '<div class="card-t mb-s mt" style="font-size:14px">专家逐条审阅（建议 #'+s.id+'）</div>'+
      '<div class="alert info"><div class="t-xs">每一条 AI 建议均需专家显式确认；选择“修改”后可直接编辑 JSON。提交后系统会把【AI 原始建议 ↔ 专家定稿】的逐项差异写入司法哈希链。</div></div>'+
      '<div class="fw-6 t-sm mb-s">字段建议</div>'+fieldRows+
      '<div class="fw-6 t-sm mb-s mt">规则建议</div>'+ruleRows;
  }

  window.setDecision=function(kind,i,action){
    var store=reviewState[kind];
    store[i]=store[i]||{};
    store[i].action=action;
    var box=document.getElementById('mod-'+kind+'-'+i);
    if(!box) return;
    if(action==='modify'){
      var orig=(reviewState.ai&&reviewState.ai[kind]&&reviewState.ai[kind][i])||{};
      box.classList.remove('hide');
      box.innerHTML='<textarea class="txta mono t-xs" rows="4" placeholder="JSON" onchange="setModifyValue(\''+kind+'\','+i+',this.value)">'+esc(JSON.stringify(orig,null,2))+'</textarea>'+
                    '<div class="t-xs muted">保持合法 JSON；字段需包含 name/label/type，规则需包含 condition/result</div>';
      store[i].value=orig;
    }else{
      box.classList.add('hide');
      box.innerHTML='';
      delete store[i].value;
    }
  };
  window.setModifyValue=function(kind,i,text){
    try{
      reviewState[kind][i].value=JSON.parse(text);
      App.toast('已更新修改内容','ok');
    }catch(e){ App.toast('JSON 格式错误，未保存','err'); }
  };
  window.setNote=function(kind,i,note){
    reviewState[kind][i]=reviewState[kind][i]||{action:'accept'};
    reviewState[kind][i].note=note;
  };

  window.submitReview=function(taskId,sid){
    if(reviewState.sid!==sid){ App.toast('审阅上下文已失效，请重新打开详情','err'); return; }
    var toList=function(store){
      return Object.keys(store).map(function(k){
        return Object.assign({index:parseInt(k,10)}, store[k]);
      });
    };
    var feedbackEl=document.getElementById('expertMod');
    App.api('/api/template-research/'+taskId+'/suggestions/'+sid+'/review',{
      method:'POST',
      body:JSON.stringify({
        decisions:{ fields:toList(reviewState.fields), rules:toList(reviewState.rules) },
        feedback: feedbackEl?feedbackEl.value.trim():''
      })
    }).then(function(d){
      if(d.success===false){ App.toast(d.message||'审阅失败','err'); return; }
      App.toast('审阅定稿已保存，差异已入链留痕','ok');
      showDetail(taskId); loadTasks();
    }).catch(function(){ App.toast('审阅提交失败','err'); });
  };

  window.genSuggest=function(id){
    App.api('/api/template-research/'+id+'/ai-suggest',{method:'POST'}).then(function(d){
      App.toast(d.message||'AI 建议已生成','ok'); showDetail(id);
    }).catch(function(){ App.toast('生成失败','err'); });
  };
  window.saveModify=function(id){
    var mod=document.getElementById('expertMod').value.trim();
    App.api('/api/template-research/'+id,{method:'PUT',body:JSON.stringify({expert_modifications:mod})}).then(function(d){
      App.toast(d.message||'已保存','ok'); showDetail(id);
    }).catch(function(){ App.toast('保存失败','err'); });
  };
  window.publishTpl=function(id){
    App.api('/api/template-research/'+id+'/publish',{method:'PUT'}).then(function(d){
      App.toast(d.message||'发布成功','ok'); showDetail(id); loadTasks();
    }).catch(function(){ App.toast('发布失败','err'); });
  };

  window.showDetail=showDetail;
  window.showCreateForm=function(){ document.getElementById('createForm').classList.remove('hide'); loadRegulations(); document.getElementById('createForm').scrollIntoView({behavior:'smooth'}); };
  window.hideCreateForm=function(){ var f=document.getElementById('createForm'); f.classList.add('hide'); document.getElementById('task_name').value=''; document.getElementById('task_description').value=''; document.getElementById('standards').value=''; document.getElementById('regSelect').value=''; document.getElementById('clauseBox').innerHTML=''; };
  window.createTask=function(){
    var name=document.getElementById('task_name').value.trim();
    var desc=document.getElementById('task_description').value.trim();
    var std=document.getElementById('standards').value.trim();
    if(!name){ App.toast('任务名称不能为空','err'); return; }
    var boxes=document.querySelectorAll('#clauseBox input[type=checkbox]:checked');
    var ids=[], texts=[];
    boxes.forEach(function(b){ ids.push(b.value); texts.push(b.getAttribute('data-text')||''); });
    App.api('/api/template-research',{method:'POST',body:JSON.stringify({task_name:name,task_description:desc,standards:std,selected_clause_ids:ids.join(','),selected_clause_text:texts.join('\n')})}).then(function(d){
      if(d.success===false){ App.toast(d.message||'创建失败','err'); return; }
      App.toast(d.message||'创建成功','ok'); hideCreateForm(); loadTasks();
    }).catch(function(){ App.toast('创建失败','err'); });
  };

  loadTasks();
})();
</script>
<%- include('partials/foot') %>
