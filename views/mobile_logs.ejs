<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta http-equiv="Cache-Control" content="no-cache,no-store,must-revalidate">
<title>司法留痕 · 特种设备AI</title>
<style>
:root{
  --p:#2f6bff;
  --p-d:#1d4ed8;
  --s:#16a34a;
  --d:#dc2626;
  --w:#d97706;
  --bg:#f1f5f9;
  --card:#fff;
  --navy:#0a1628;
  --navy-2:#1e3a5f;
  --tx:#1e2a3a;
  --t2:#5b6b81;
  --t3:#93a1b5;
  --t4:#c0c8d4;
  --bd:#e5e9f0;
  --bdr:12px;
  --sh:0 1px 3px rgba(16,28,56,.05),0 6px 18px rgba(16,28,56,.06);
  --term-bg:#0a1628;
  --term-border:#16284d;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{font:13px/1.5 -apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;background:var(--bg);color:var(--tx);margin:0 auto;min-height:100vh;max-width:480px}
.ic{width:18px;height:18px;stroke:currentColor;flex-shrink:0;vertical-align:middle}
.m-shell{min-height:100vh;padding-bottom:56px}
.m-topbar{background:linear-gradient(135deg,#0a1628 0%,#1e3a5f 100%);color:#fff;padding:15px 16px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50;box-shadow:0 2px 10px rgba(10,22,40,.18)}
.m-topbar .tl{font-size:15px;font-weight:600;display:flex;align-items:center;gap:8px}
.m-topbar .tl .ic{width:19px;height:19px;stroke:#fff}
.m-content{padding:12px}
.m-card{background:var(--card);border:1px solid var(--bd);border-radius:var(--bdr);padding:14px;margin-bottom:12px;box-shadow:var(--sh)}
.m-card-h{font-size:13px;font-weight:700;margin-bottom:11px;display:flex;align-items:center;justify-content:space-between;color:var(--tx)}
.m-card-h .ic{width:16px;height:16px;stroke:var(--p);margin-right:6px;vertical-align:-3px}

/* ── 终端风格哈希链 ── */
.m-terminal{background:var(--term-bg);border-radius:10px;padding:12px;max-height:280px;overflow-y:auto;font:9.5px/1.6 'Menlo','Monaco','Courier New',monospace;border:1px solid var(--term-border)}
.m-terminal .tb{margin-bottom:6px;padding:7px 8px;background:rgba(255,255,255,.04);border-radius:5px;border-left:3px solid #2f6bff;position:relative}
.m-terminal .tb:last-child{margin-bottom:0}
.m-terminal .tb .t-id{color:#e94560;font-weight:700;font-size:8px}
.m-terminal .tb .t-act{font-size:8px;display:inline-block;padding:0 5px;background:#e94560;color:#fff;border-radius:2px;margin-left:4px}
.m-terminal .tb .t-info{color:#a8d8ea;font-size:8px;margin-top:3px;word-break:break-all}
.m-terminal .tb .t-user{color:#6a9955;font-size:8px}
.m-terminal .tb .t-arrow{color:#546e7a}
.m-terminal .tb .t-hash{color:#4ec9b0;font-size:8px;word-break:break-all}
.m-terminal .tb .t-prev{color:#ce9178;font-size:8px;word-break:break-all}
.m-terminal .tb .t-time{color:#808080;font-size:7px;margin-top:2px}

/* ── 验证结果 ── */
.m-verify-res{background:var(--card);border:1px solid var(--bd);border-radius:var(--bdr);padding:14px;margin-bottom:12px;box-shadow:var(--sh)}
.m-verify-res .v-hd{font-size:13px;font-weight:700;margin-bottom:8px}
.m-verify-res .v-row{display:flex;justify-content:space-between;padding:5px 0;font-size:12px}
.m-verify-res .v-row .vl{color:var(--t2)}
.m-verify-res .v-err{background:#fdecee;color:var(--d);padding:6px 8px;border-radius:8px;font-size:11px;margin-top:6px;word-break:break-all}

/* ── 普通日志列表 ── */
.m-log-item{padding:9px 0;border-bottom:1px solid #f0f2f6;font-size:11px}
.m-log-item:last-child{border-bottom:none}
.m-log-item .li-hd{display:flex;justify-content:space-between;align-items:center}
.m-log-item .li-id{color:var(--t3);font-weight:500}
.m-log-item .li-act{font-weight:500}
.m-log-item .li-dt{color:var(--t3);font-size:10px;margin-top:2px}
.m-log-item .li-hash{color:var(--t3);font-size:9px;margin-top:1px;word-break:break-all}

.m-btn{display:block;width:100%;padding:11px;border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;text-align:center;transition:opacity .15s,transform .15s}
.m-btn:active{opacity:.85;transform:scale(.99)}
.m-btn:disabled{opacity:.5;cursor:not-allowed}
.m-btn-p{background:var(--p);color:#fff;box-shadow:0 4px 12px rgba(47,107,255,.28)}
.m-btn-s{background:var(--s);color:#fff;box-shadow:0 4px 12px rgba(22,163,74,.25)}
.m-btn-s:active{background:#15803d}
.m-btn .ic{width:16px;height:16px;stroke:#fff;vertical-align:-3px;margin-right:6px}
.m-tag{display:inline-flex;align-items:center;padding:2px 7px;border-radius:6px;font-size:10px;font-weight:600;line-height:1.6;white-space:nowrap}
.m-tag-ok{background:#e7f7ee;color:var(--s)}
.m-tag-ng{background:#fdecee;color:var(--d)}
.m-tag-info{background:#eaf1ff;color:var(--p)}

.m-loading{text-align:center;padding:20px;color:var(--t3);font-size:12px}
.m-empty{text-align:center;padding:20px;color:var(--t3);font-size:12px}

/* ── 弹窗 ── */
.m-overlay{position:fixed;inset:0;background:rgba(10,22,40,.5);z-index:200;display:flex;align-items:center;justify-content:center;padding:16px;backdrop-filter:blur(2px)}
.m-modal{background:#fff;border-radius:16px;max-width:360px;width:100%;max-height:70vh;overflow:hidden;display:flex;flex-direction:column;animation:mFadeIn .18s ease;box-shadow:0 20px 50px rgba(10,22,40,.3)}
@keyframes mFadeIn{from{opacity:0;transform:scale(.93)}to{opacity:1;transform:scale(1)}}
.m-modal-h{padding:14px 16px 11px;font-size:14px;font-weight:600;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #f0f2f6;flex-shrink:0}
.m-modal-close{font-size:20px;cursor:pointer;color:var(--t3);width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:50%}
.m-modal-close:active{background:var(--bg)}
.m-modal-b{padding:12px 16px 16px;overflow-y:auto;flex:1}

/* ── TabBar ── */
.m-tabbar{position:fixed;bottom:0;left:0;right:0;max-width:480px;margin:0 auto;height:50px;background:#fff;display:flex;box-shadow:0 -1px 4px rgba(0,0,0,.06);z-index:100;border-top:1px solid #f0f0f0}
.m-tabbar a{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-decoration:none;color:var(--t3);font-size:9px;transition:color .15s}
.m-tabbar a.on{color:var(--p)}
.m-tabbar a span{font-size:20px;margin-bottom:1px}
</style>
<!-- BUG-04：复用统一的时区安全格式化助手（App.fmtDT 按 UTC 解析后本地化） -->
<script src="/js/app.js"></script>
</head>
<body class="iphone-host">
<%- include('partials/iphone_frame_start') %>

<div class="m-shell">

<div class="m-topbar">
<div class="tl"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>司法留痕</div>
</div>

<div class="m-content">

<!-- 哈希链（最近5条，终端风格） -->
<div class="m-card">
<div class="m-card-h"><span><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>哈希链（最近）</span><span id="chainCount" class="m-tag m-tag-info" style="font-size:9px">0</span></div>
<div class="m-terminal" id="chainContainer">
<div class="m-loading" style="color:#808080">加载中...</div>
</div>
</div>

<!-- 验证按钮 -->
<button class="m-btn m-btn-s" id="btnVerify" onclick="verifyChain()"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>验证哈希链完整性</button>

<!-- 验证结果区 -->
<div id="verifyResultArea" style="display:none"></div>

<!-- 全部日志列表 -->
<div class="m-card">
<div class="m-card-h"><span><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>全部操作日志</span><span id="logTotal" style="font-size:11px;font-weight:500;color:var(--t3)"></span></div>
<div id="logList"><div class="m-loading">加载中...</div></div>
</div>

</div>
</div>


<script>
// ── 加载日志数据 ──
function loadLogs(){
  fetch('/api/operation-logs',{credentials:'include'})
    .then(function(r){if(!r.ok)throw new Error('请求失败');return r.json()})
    .then(function(d){
      var logs=d.data||[];
      var total=d.total||logs.length;
      document.getElementById('logTotal').textContent='共 '+total+' 条';

      // 哈希链（最近5条）
      var chainContainer=document.getElementById('chainContainer');
      var recent5=logs.slice(0,5);
      document.getElementById('chainCount').textContent=recent5.length+'条';

      if(recent5.length===0){
        chainContainer.innerHTML='<div style="color:#808080;text-align:center;padding:10px">暂无操作记录</div>';
      }else{
        chainContainer.innerHTML=recent5.map(function(l){
          return '<div class="tb">'+
            '<div><span class="t-id">#'+l.id+'</span><span class="t-act">'+escHtml(l.action)+'</span></div>'+
            '<div class="t-user">'+(l.user_email||'system')+'</div>'+
            '<div class="t-info"><span class="t-arrow">← prev:</span> <span class="t-prev">'+(l.prev_hash?l.prev_hash.substring(0,12)+'…':'Genesis')+'</span></div>'+
            '<div class="t-info"><span class="t-arrow">→ hash:</span> <span class="t-hash">'+(l.hash?l.hash.substring(0,20)+'…':'')+'</span></div>'+
            '<div class="t-time">'+(l.timestamp||'').substring(0,19)+'</div>'+
          '</div>';
        }).join('');
      }

      // 全部日志
      var logList=document.getElementById('logList');
      if(logs.length===0){
        logList.innerHTML='<div class="m-empty">暂无操作日志</div>';
      }else{
        logList.innerHTML=logs.map(function(l){
          var t=l.timestamp||'';
          return '<div class="m-log-item">'+
            '<div class="li-hd"><span class="li-id">#'+l.id+'</span><span class="li-act">'+escHtml(l.action)+'</span></div>'+
            '<div class="li-dt">'+(l.user_email||'system')+' · '+(t.substring(0,19)||'')+'</div>'+
            '<div class="li-hash">← '+(l.prev_hash?l.prev_hash.substring(0,16)+'…':'Genesis')+' → '+(l.hash?l.hash.substring(0,24)+'…':'')+'</div>'+
          '</div>';
        }).join('');
      }
    })
    .catch(function(e){
      document.getElementById('chainContainer').innerHTML='<div style="color:#e94560;text-align:center;padding:10px">加载失败</div>';
      document.getElementById('logList').innerHTML='<div class="m-loading" style="color:var(--d)">加载失败：'+e.message+'</div>';
    });
}

function escHtml(s){
  if(!s)return'';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── 验证哈希链 ──
function verifyChain(){
  var btn=document.getElementById('btnVerify');
  btn.disabled=true;
  btn.textContent='⏳ 验证中...';

  fetch('/api/operation-logs/verify',{credentials:'include',
    method:'POST',
    headers:{'Content-Type':'application/json'},
    credentials:'include',
    body:'{}'
  })
  .then(function(r){if(!r.ok)throw new Error('请求失败');return r.json()})
  .then(function(d){
    var area=document.getElementById('verifyResultArea');
    var ok=d.isValid;
    area.style.display='block';
    area.innerHTML=
      '<div class="m-verify-res">'+
        '<div class="v-hd">'+(ok?'✅ 验证通过':'❌ 验证失败')+'</div>'+
        '<div class="v-row"><span class="vl">总区块</span><span>'+(d.totalBlocks||0)+'</span></div>'+
        '<div class="v-row"><span class="vl">状态</span><span class="m-tag '+(ok?'m-tag-ok':'m-tag-ng')+'">'+(ok?'完整':'异常')+'</span></div>'+
        (d.errors&&d.errors.length>0?'<div class="v-err">'+d.errors.join('<br>')+'</div>':'')+
      '</div>';
    area.scrollIntoView({behavior:'smooth',block:'center'});
  })
  .catch(function(e){
    alert('验证失败：'+e.message);
  })
  .finally(function(){
    btn.disabled=false;
    btn.textContent='🔍 验证哈希链完整性';
  });
}

// ── 初始加载 ──
loadLogs();
</script>

<%- include('partials/iphone_frame_end') %>
</body>
</html>
