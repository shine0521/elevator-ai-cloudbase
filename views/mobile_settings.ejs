<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta http-equiv="Cache-Control" content="no-cache,no-store,must-revalidate">
<title>系统设置 · 特种设备AI</title>
<style>
:root{
  --p:#2f6bff;
  --p-d:#1d4ed8;
  --s:#16a34a;
  --d:#dc2626;
  --w:#d97706;
  --bg:#f1f5f9;
  --card:#fff;
  --navy:#0a1628;
  --navy-2:#1e3a5f;
  --tx:#1e2a3a;
  --t2:#5b6b81;
  --t3:#93a1b5;
  --t4:#c0c8d4;
  --bd:#e5e9f0;
  --bdr:12px;
  --sh:0 1px 3px rgba(16,28,56,.05),0 6px 18px rgba(16,28,56,.06);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{font:13px/1.5 -apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;background:var(--bg);color:var(--tx);margin:0 auto;min-height:100vh;max-width:480px}
.ic{width:18px;height:18px;stroke:currentColor;flex-shrink:0;vertical-align:middle}
.m-shell{min-height:100vh;padding-bottom:56px}
.m-topbar{background:linear-gradient(135deg,#0a1628 0%,#1e3a5f 100%);color:#fff;padding:15px 16px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50;box-shadow:0 2px 10px rgba(10,22,40,.18)}
.m-topbar .tl{font-size:15px;font-weight:600;display:flex;align-items:center;gap:8px}
.m-topbar .tl .ic{width:19px;height:19px;stroke:#fff}
.m-content{padding:12px}

.m-card{background:var(--card);border:1px solid var(--bd);border-radius:var(--bdr);padding:14px;margin-bottom:12px;box-shadow:var(--sh)}
.m-card-h{font-size:13px;font-weight:700;margin-bottom:11px;color:var(--tx);display:flex;align-items:center;gap:6px}
.m-card-h .ic{width:16px;height:16px;stroke:var(--p);flex-shrink:0}

/* ── 头像卡片 ── */
.m-avatar-card{display:flex;align-items:center;gap:12px;padding:14px;background:var(--card);border:1px solid var(--bd);border-radius:var(--bdr);margin-bottom:12px;box-shadow:var(--sh)}
.m-avatar{width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,#2f6bff,#5b8bff);color:#fff;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;flex-shrink:0;box-shadow:0 4px 12px rgba(47,107,255,.35)}
.m-avatar-info{flex:1;min-width:0}
.m-avatar-info .an{font-size:15px;font-weight:600}
.m-avatar-info .ae{font-size:11px;color:var(--t2);margin-top:2px}

/* ── 行 ── */
.m-row{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid #f0f2f6;font-size:12px}
.m-row:last-child{border-bottom:none}
.m-row .rl{color:var(--t3);display:flex;align-items:center;gap:8px;font-weight:500}
.m-row .rl .ic{width:15px;height:15px;stroke:var(--t2);flex-shrink:0}
.m-row .rr{color:var(--tx);text-align:right;word-break:break-all}
.m-row .rr .m-tag{display:inline-flex;align-items:center;padding:2px 7px;border-radius:6px;font-size:10px;font-weight:600;line-height:1.6}

.m-tag{display:inline-flex;align-items:center;padding:2px 7px;border-radius:6px;font-size:10px;font-weight:600;line-height:1.6;white-space:nowrap}
.m-tag-ok{background:#e7f7ee;color:var(--s)}
.m-tag-ng{background:#fdecee;color:var(--d)}
.m-tag-mb{background:#fdf3e0;color:var(--w)}
.m-tag-info{background:#eaf1ff;color:var(--p)}

.m-btn{display:block;width:100%;padding:11px;border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;text-align:center;transition:opacity .15s,transform .15s}
.m-btn:active{opacity:.85;transform:scale(.99)}
.m-btn-d{background:var(--d);color:#fff;box-shadow:0 4px 12px rgba(220,38,38,.25)}
.m-btn-g{background:var(--card);color:var(--p);border:1px solid var(--bd);box-shadow:var(--sh)}
.m-btn-g .ic{stroke:var(--p)}
.m-btn .ic{width:16px;height:16px;stroke:#fff;vertical-align:-3px;margin-right:6px}

/* ── 关于脚注 ── */
.m-footer{text-align:center;padding:12px 10px 8px;font-size:10px;color:var(--t4)}

/* ── 确认弹窗 ── */
.m-overlay{position:fixed;inset:0;background:rgba(10,22,40,.5);z-index:200;display:flex;align-items:center;justify-content:center;padding:16px;backdrop-filter:blur(2px)}
.m-modal{background:#fff;border-radius:16px;max-width:300px;width:100%;overflow:hidden;animation:mFadeIn .18s ease;box-shadow:0 20px 50px rgba(10,22,40,.3)}
@keyframes mFadeIn{from{opacity:0;transform:scale(.93)}to{opacity:1;transform:scale(1)}}
.m-modal-b{padding:22px 18px 18px;text-align:center}
.m-modal-b .mq{font-size:36px;display:block;margin-bottom:6px}
.m-modal-b .mt{font-size:15px;font-weight:600;margin-bottom:4px}
.m-modal-b .md{font-size:12px;color:var(--t2);margin-bottom:16px}
.m-modal-actions{display:flex;gap:8px}
.m-modal-actions button{flex:1;height:38px;border:none;border-radius:10px;font-size:13px;cursor:pointer}
.m-modal-actions .ca{background:var(--d);color:#fff;font-weight:500}
.m-modal-actions .ca:active{opacity:.85}
.m-modal-actions .cc{background:var(--bg);color:var(--tx)}

/* ── TabBar ── */
.m-tabbar{position:fixed;bottom:0;left:0;right:0;max-width:480px;margin:0 auto;height:50px;background:#fff;display:flex;box-shadow:0 -1px 4px rgba(0,0,0,.06);z-index:100;border-top:1px solid #f0f0f0}
.m-tabbar a{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-decoration:none;color:var(--t3);font-size:9px;transition:color .15s}
.m-tabbar a.on{color:var(--p)}
.m-tabbar a span{font-size:20px;margin-bottom:1px}
</style>
<!-- BUG-04：复用统一的时区安全格式化助手（App.fmtDT 按 UTC 解析后本地化） -->
<script src="/js/app.js"></script>
</head>
<body class="iphone-host">
<%- include('partials/iphone_frame_start') %>

<div class="m-shell">

<div class="m-topbar">
<div class="tl"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>系统设置</div>
</div>

<div class="m-content">

<!-- 用户头像卡片 -->
<div class="m-avatar-card">
<div class="m-avatar"><%= user.name ? user.name.charAt(0) : '?' %></div>
<div class="m-avatar-info">
<div class="an"><%= user.name || '用户' %></div>
<div class="ae"><%= user.email || '-' %></div>
</div>
<div><span class="m-tag m-tag-<%= user.role==='admin'?'info':user.role==='auditor'?'mb':'ok' %>"><%= user.role==='admin'?'管理员':user.role==='auditor'?'审核员':'用户' %></span></div>
</div>

<!-- 详细信息 -->
<div class="m-card">
<div class="m-card-h"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>个人资料</div>
<div class="m-row"><span class="rl"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 6 10 7L22 6"/></svg>邮箱</span><span class="rr"><%= user.email || '-' %></span></div>
<div class="m-row"><span class="rl"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>姓名</span><span class="rr"><%= user.name || '-' %></span></div>
<div class="m-row"><span class="rl"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>角色</span><span class="rr"><%= user.role==='admin'?'管理员':user.role==='auditor'?'审核员':'用户' %></span></div>
<div class="m-row"><span class="rl"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h16"/><path d="M4 15h16"/><path d="M10 3 8 21"/><path d="M16 3l-2 18"/></svg>ID</span><span class="rr" style="font-size:10px;color:var(--t3)"><%= user.id || '-' %></span></div>
</div>

<!-- 系统信息 -->
<div class="m-card">
<div class="m-card-h"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>系统信息</div>
<div class="m-row"><span class="rl"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg>版本</span><span class="rr">V4.0</span></div>
<div class="m-row"><span class="rl"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M12 6h.01"/><path d="M16 6h.01"/><path d="M8 10h.01"/><path d="M12 10h.01"/><path d="M16 10h.01"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/></svg>架构</span><span class="rr">三层解耦</span></div>
<div class="m-row"><span class="rl"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9z"/></svg>引擎</span><span class="rr">确定性规则</span></div>
<div class="m-row"><span class="rl"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>留痕</span><span class="rr">SHA-256 哈希链</span></div>
<div class="m-row"><span class="rl"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/></svg>数据库</span><span class="rr">SQLite</span></div>
</div>

<!-- 切换视图 -->
<% const _tHref = (typeof toggleViewHref!=='undefined' && toggleViewHref) ? toggleViewHref : '/?view=pc'; %>
<% const _tLabel = (typeof toggleViewLabel!=='undefined' && toggleViewLabel) ? toggleViewLabel : '桌面版'; %>
<% const _tIcon  = (typeof toggleViewIcon!=='undefined' && toggleViewIcon) ? toggleViewIcon : '💻'; %>
<a class="m-btn m-btn-g" href="<%= _tHref %>" style="margin-bottom:10px"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>切换<%= _tLabel %></a>

<!-- 视图切换 -->
<a class="m-btn m-btn-g" href="<%= typeof toggleViewHref!=='undefined'?toggleViewHref:'/?view=pc' %>" style="margin-bottom:10px;text-decoration:none;display:flex;align-items:center;justify-content:center">
  <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
  切换桌面版
</a>

<!-- 退出登录 -->
<a class="m-btn m-btn-g" href="<%= typeof toggleViewHref!=='undefined'?toggleViewHref:'/?view=pc' %>" style="margin-bottom:10px"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>切换到<%= typeof toggleViewLabel!='undefined'?toggleViewLabel:'桌面版' %></a>
<button class="m-btn m-btn-d" onclick="confirmLogout()"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>退出登录</button>

<div class="m-footer">特种设备电梯安全管理AI系统</div>

</div>
</div>


<script>
function confirmLogout(){
  document.body.style.overflow='hidden';
  var overlay=document.createElement('div');
  overlay.className='m-overlay';
  overlay.onclick=function(e){if(e.target===overlay)removeOverlay(overlay)};

  var modal=document.createElement('div');
  modal.className='m-modal';
  modal.innerHTML=
    '<div class="m-modal-b">'+
      '<span class="mq">🚪</span>'+
      '<div class="mt">确认退出登录？</div>'+
      '<div class="md">退出后需要重新登录才能使用系统</div>'+
      '<div class="m-modal-actions">'+
        '<button class="cc" onclick="removeOverlay(this.closest(\'.m-overlay\'))">取消</button>'+
        '<button class="ca" onclick="doLogout()">退出</button>'+
      '</div>'+
    '</div>';
  overlay.appendChild(modal);
  document.body.appendChild(overlay);
}

function removeOverlay(overlay){
  if(overlay&&overlay.parentNode)overlay.parentNode.removeChild(overlay);
  document.body.style.overflow='';
}

function doLogout(){
  window.location.href='/logout';
}
</script>

<%- include('partials/iphone_frame_end') %>
</body>
</html>
