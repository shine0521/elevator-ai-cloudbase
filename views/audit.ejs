<%- include('partials/head') %>
<div class="shell">
<%- include('partials/sidebar', {user: user}) %>
<main class="main">
  <%- include('partials/topbar', {user: user, title: '人工审核'}) %>
  <div class="content">
    <div class="page-hd">
      <div>
        <div class="pt">人工审核工作台</div>
        <div class="pd">AI 无法自动判定的判别记录在此由专家终审 · 批准或驳回均需司法留痕</div>
      </div>
      <span class="tag purple">待审核 <b id="totalCount">--</b></span>
    </div>

    <div class="card">
      <div class="card-h">
        <div class="ct"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3 8-8"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>审核任务队列</div>
        <button class="btn btn-o btn-sm" onclick="loadTasks()">刷新</button>
      </div>
      <div class="card-b">
        <div class="tbl-wrap">
          <table class="tbl">
            <thead>
              <tr><th style="width:64px">任务ID</th><th>模板名称</th><th style="width:92px">AI判别</th><th style="width:92px">状态</th><th>提交人</th><th style="width:140px">提交时间</th><th style="width:84px">操作</th></tr>
            </thead>
            <tbody id="tableBody">
              <tr><td colspan="7" class="empty" style="padding:40px">加载中...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</main>
</div>

<div class="overlay" id="auditModal">
  <div class="modal" style="max-width:780px">
    <div class="modal-h"><span class="mt">审核详情</span><button class="x" onclick="App.closeModal('auditModal')">✕</button></div>
    <div class="modal-b" id="modalBody">加载中...</div>
    <div class="modal-b" id="auditForm" style="border-top:1px solid var(--border);padding-top:16px;display:none">
      <div class="field">
        <label>审核意见 <span class="hint">驳回时必填</span></label>
        <textarea class="txta" id="auditComment" rows="3" placeholder="请输入审核意见"></textarea>
      </div>
    </div>
    <div class="modal-f">
      <button class="btn btn-o" onclick="App.closeModal('auditModal')">关闭</button>
      <button class="btn btn-s" id="btnApprove" onclick="doAudit('approve')">批准</button>
      <button class="btn btn-d" id="btnReject" onclick="doAudit('reject')">驳回</button>
    </div>
  </div>
</div>

<script>
(function(){
  var currentTaskId=null, currentRecordId=null;
  function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
  function pad(n){return String(n).padStart(2,'0');}

  function loadTasks(){
    var tbody=document.getElementById('tableBody');
    tbody.innerHTML='<tr><td colspan="7" class="empty" style="padding:40px">加载中...</td></tr>';
    App.api('/api/audit-tasks').then(function(d){
      var data=d.data||[];
      document.getElementById('totalCount').textContent=data.length;
      if(data.length===0){ tbody.innerHTML='<tr><td colspan="7" class="empty" style="padding:40px">暂无待审核任务</td></tr>'; return; }
      tbody.innerHTML=data.map(function(t){
        var aiTag=t.final_result==='合规'?'<span class="tag ok">合规</span>':
                  t.final_result==='不合规'?'<span class="tag ng">不合规</span>':
                  '<span class="tag mb">'+(esc(t.final_result)||'待人工')+'</span>';
        var stTag=t.status==='approved'?'<span class="tag ok">已批准</span>':
                  t.status==='rejected'?'<span class="tag ng">已驳回</span>':
                  '<span class="tag mb">待审核</span>';
        // BUG-04：优先用后端下发的 *_iso，否则按 UTC 解析 SQLite 时间串
        var ts=App.fmtDT(t.submitted_at_iso||t.submitted_at||t.created_at_iso||t.created_at);
        var actionBtn=t.status==='pending'?
          '<button class="btn btn-p btn-sm" onclick="showAudit('+t.id+','+t.record_id+')">审核</button>':
          '<span class="muted">已完成</span>';
        return '<tr>'+
               '<td class="mono" style="color:var(--primary-d)">#'+t.id+'</td>'+
               '<td class="cell-main">'+esc(t.template_name||'')+'</td>'+
               '<td>'+aiTag+'</td>'+
               '<td>'+stTag+'</td>'+
               '<td class="muted">'+esc(t.submitter_email||'')+'</td>'+
               '<td class="muted">'+ts+'</td>'+
               '<td>'+actionBtn+'</td></tr>';
      }).join('');
    }).catch(function(){ tbody.innerHTML='<tr><td colspan="7" class="empty" style="padding:40px;color:var(--danger)">加载失败</td></tr>'; });
  }

  function showAudit(taskId, recordId){
    currentTaskId=taskId; currentRecordId=recordId;
    document.getElementById('modalBody').innerHTML='<div class="empty" style="padding:40px"><span class="spinner"></span></div>';
    document.getElementById('auditForm').style.display='block';
    App.openModal('auditModal');
    document.getElementById('auditComment').value='';
    App.api('/api/discrimination-records/'+recordId).then(function(d){
      var rec=d.record||{};
      var tag=rec.final_result==='合规'?'<span class="tag ok">合规</span>':
              rec.final_result==='不合规'?'<span class="tag ng">不合规</span>':
              '<span class="tag mb">'+(esc(rec.final_result)||'待人工')+'</span>';
      var rawRules=rec.rule_results;
      var rulesArr=Array.isArray(rawRules)?rawRules:[];
      var isSummary=!Array.isArray(rawRules)&&rawRules&&typeof rawRules==='object';
      var rulesHtml;
      if(isSummary){
        var s=rawRules;
        var matched=s.matched!=null?s.matched:'-';
        var total=s.total!=null?s.total:'-';
        var sevRaw=s.severity||'';
        var sevZh=sevRaw==='high'?'高':sevRaw==='mid'?'中':sevRaw==='low'?'低':sevRaw==='mandatory'?'强制项':sevRaw==='recommended'?'推荐项':sevRaw==='optional'?'可选项':sevRaw||'-';
        rulesHtml='<div class="rule"><div class="rh"><span style="font-size:17px">📋</span><span class="rn">规则执行概要</span></div>'+
               '<div class="rd">匹配命中：<strong>'+esc(String(matched))+'</strong> / '+esc(String(total))+'</div>'+
               '<div class="rd">严重级别：'+esc(sevZh)+'</div>'+
               '<div class="rd muted">（摘要型记录。完整规则明细由规则引擎执行时生成，访“判别”页可实时运行）</div></div>';
      }else{
        rulesHtml=rulesArr.map(function(rule){
          var cls=rule.status==='success'?'pass':rule.status==='error'?'fail':'pass';
          var icon=rule.status==='success'?'✅':rule.status==='error'?'❌':'⚠️';
          return '<div class="rule '+cls+'"><div class="rh"><span style="font-size:17px">'+icon+'</span><span class="rn">'+esc(rule.name||'')+'</span>'+(rule.result?'<span class="tag '+(rule.status==='success'?'ok':'ng')+'">'+esc(rule.result)+'</span>':'')+'</div>'+
                 (rule.description?'<div class="rd">'+esc(rule.description)+'</div>':'')+
                 (rule.detail?'<div class="rd" style="color:var(--primary-d)">'+esc(rule.detail)+'</div>':'')+
                 (rule.formula?'<div class="rf">'+esc(rule.formula)+'</div>':'')+
                 (rule.clause?'<div class="rc">依据条款：'+esc(rule.clause)+'</div>':'')+'</div>';
        }).join('');
      }
      document.getElementById('modalBody').innerHTML=
        '<div class="kv mb"><span class="k">判别 ID</span><span class="v">#'+esc(rec.id)+'</span>'+
          '<span class="k">模板</span><span class="v">'+esc(rec.template_name||'')+'</span>'+
          '<span class="k">提交人</span><span class="v">'+esc(rec.user_email||'')+'</span>'+
          '<span class="k">AI判别</span><span class="v">'+tag+'</span></div>'+
        (rec.conclusion?'<div class="alert ok mb" style="border-radius:8px">'+esc(rec.conclusion)+'</div>':'')+
        '<div class="card-t mb-s mt" style="font-size:14px">规则执行明细</div>'+
        (rulesHtml||'<div class="muted">无规则明细</div>');
    }).catch(function(){ document.getElementById('modalBody').innerHTML='<div class="empty" style="padding:30px;color:var(--danger)">加载失败</div>'; });
  }

  function closeAudit(){ App.closeModal('auditModal'); currentTaskId=null; currentRecordId=null; }

  window.doAudit=function(action){
    var comment=document.getElementById('auditComment').value.trim();
    if(action==='reject'&&!comment){ App.toast('驳回时必须填写审核意见','err'); return; }
    var btn=action==='approve'?document.getElementById('btnApprove'):document.getElementById('btnReject');
    btn.disabled=true; btn.textContent='处理中...';
    App.api('/api/audit-tasks/'+currentTaskId+'/action',{method:'POST',body:JSON.stringify({action:action,comment:comment})}).then(function(d){
      App.toast(d.message||'操作成功','ok');
      btn.disabled=false; btn.textContent=action==='approve'?'批准':'驳回';
      closeAudit(); loadTasks();
    }).catch(function(){
      btn.disabled=false; btn.textContent=action==='approve'?'批准':'驳回';
      App.toast('操作失败','err');
    });
  };

  window.showAudit=showAudit;
  loadTasks();
})();
</script>
<%- include('partials/foot') %>
