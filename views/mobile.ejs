<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta http-equiv="Cache-Control" content="no-cache,no-store,must-revalidate">
<title>首页 · 特种设备AI</title>
<style>
:root{
  --p:#2f6bff;            /* 主色蓝 */
  --p-d:#1d4ed8;
  --s:#16a34a;            /* 成功绿 */
  --d:#dc2626;            /* 危险红 */
  --w:#d97706;            /* 警告琥珀 */
  --bg:#f1f5f9;           /* 背景 */
  --card:#fff;            /* 卡片 */
  --navy:#0a1628;         /* 深蓝 */
  --navy-2:#1e3a5f;
  --tx:#1e2a3a;
  --t2:#5b6b81;
  --t3:#93a1b5;
  --t4:#c0c8d4;
  --bd:#e5e9f0;           /* 边框 */
  --bdr:12px;             /* 圆角 */
  --sh:0 1px 3px rgba(16,28,56,.05),0 6px 18px rgba(16,28,56,.06);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{font:13px/1.5 -apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;background:var(--bg);color:var(--tx);margin:0 auto;min-height:100vh;max-width:480px}
a{text-decoration:none;color:inherit}
.ic{width:18px;height:18px;stroke:currentColor;flex-shrink:0;vertical-align:middle}

/* ── 登录页 ── */
.m-login{min-height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#0a1628 0%,#1e3a5f 100%);padding:16px}
.m-login-box{width:100%;max-width:320px;background:#fff;border-radius:16px;padding:30px 22px 22px;box-shadow:0 14px 40px rgba(10,22,40,.35)}
.m-login-ico{text-align:center;margin-bottom:8px}
.m-login-ico .ic{width:46px;height:46px;stroke:var(--p)}
.m-login-box h2{text-align:center;font-size:17px;font-weight:700;margin-bottom:2px}
.m-login-sub{text-align:center;color:var(--t3);font-size:11px;margin-bottom:22px}
.m-login-box input{width:100%;height:42px;border:1px solid var(--bd);border-radius:10px;padding:0 13px;font-size:13px;margin-bottom:11px;outline:none;transition:border-color .2s,box-shadow .2s;background:#fbfcfe}
.m-login-box input:focus{border-color:var(--p);box-shadow:0 0 0 3px rgba(47,107,255,.13)}
.m-login-box .btn-login{width:100%;height:42px;background:var(--p);color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;transition:background .2s}
.m-login-box .btn-login:active{background:var(--p-d)}
.m-login-err{color:var(--d);font-size:12px;text-align:center;margin-top:6px}
.m-login-tip{text-align:center;color:var(--t4);font-size:10px;margin-top:10px}

/* ── 应用外壳 ── */
.m-shell{min-height:100vh;padding-bottom:56px}
.m-topbar{background:linear-gradient(135deg,#0a1628 0%,#1e3a5f 100%);color:#fff;padding:15px 16px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50;box-shadow:0 2px 10px rgba(10,22,40,.18)}
.m-topbar .tl{font-size:15px;font-weight:600;display:flex;align-items:center;gap:8px}
.m-topbar .tl .ic{width:19px;height:19px;stroke:#fff}
.m-topbar .tr{font-size:11px;opacity:.9}
.m-content{padding:12px 12px 4px}

/* ── 统计卡片 ── */
.m-stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
.m-stat{background:var(--card);border:1px solid var(--bd);border-radius:var(--bdr);padding:14px 10px;text-align:center;box-shadow:var(--sh)}
.m-stat .sv{font-size:23px;font-weight:800;color:var(--p);line-height:1.2;letter-spacing:-.5px}
.m-stat .sl{font-size:10px;color:var(--t3);margin-top:3px}
.m-stat .sv.green{color:var(--s)}
.m-stat .sv.orange{color:var(--w)}
.m-stat .sv.red{color:var(--d)}

/* ── 卡片 ── */
.m-card{background:var(--card);border:1px solid var(--bd);border-radius:var(--bdr);padding:14px;margin-bottom:12px;box-shadow:var(--sh)}
.m-card-h{font-size:13px;font-weight:700;margin-bottom:11px;display:flex;align-items:center;justify-content:space-between;color:var(--tx)}
.m-card-h .ic{width:16px;height:16px;stroke:var(--p);margin-right:6px;vertical-align:-3px}
.m-card-h .more{font-size:11px;color:var(--p);font-weight:500;cursor:pointer}

/* ── 快捷按钮 ── */
.m-actions{display:flex;gap:10px;margin-bottom:12px}
.m-action-btn{flex:1;background:var(--card);border:1px solid var(--bd);border-radius:var(--bdr);padding:14px 4px;text-align:center;box-shadow:var(--sh);font-size:12px;cursor:pointer;color:var(--tx);transition:background .15s,transform .15s}
.m-action-btn:active{background:#f0f4fb;transform:scale(.98)}
.m-action-btn .ico{display:flex;align-items:center;justify-content:center;margin-bottom:6px}
.m-action-btn .ico .ic{width:26px;height:26px;stroke:var(--p)}

/* ── 表格 ── */
.m-tbl{width:100%;border-collapse:collapse;font-size:11px}
.m-tbl th{text-align:left;padding:7px 0;color:var(--t3);font-weight:600;border-bottom:1px solid var(--bd);letter-spacing:.3px}
.m-tbl td{padding:8px 0;border-bottom:1px solid #f0f2f6;vertical-align:middle}
.m-tbl tr:last-child td{border-bottom:none}

/* ── 标签 ── */
.m-tag{display:inline-flex;align-items:center;padding:2px 7px;border-radius:6px;font-size:10px;font-weight:600;white-space:nowrap;line-height:1.6}
.m-tag-ok{background:#e7f7ee;color:var(--s)}
.m-tag-ng{background:#fdecee;color:var(--d)}
.m-tag-mb{background:#fdf3e0;color:var(--w)}
.m-tag-info{background:#eaf1ff;color:var(--p)}

/* ── 按钮 ── */
.m-btn{display:block;width:100%;padding:11px;border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;text-align:center;transition:opacity .15s}
.m-btn:active{opacity:.85}
.m-btn:disabled{opacity:.5;cursor:not-allowed}
.m-btn-p{background:var(--p);color:#fff;box-shadow:0 4px 12px rgba(47,107,255,.28)}
.m-btn-p:active{background:var(--p-d)}
.m-btn-o{background:#fff;color:var(--tx);border:1px solid var(--bd)}
.m-btn-d{background:var(--d);color:#fff}
.m-btn .ic{width:16px;height:16px;stroke:#fff;vertical-align:-3px;margin-right:6px}

.m-inp{width:100%;height:38px;border:1px solid var(--bd);border-radius:10px;padding:0 12px;font-size:13px;margin-bottom:8px;outline:none;transition:border-color .2s,box-shadow .2s;background:#fff}
.m-inp:focus{border-color:var(--p);box-shadow:0 0 0 3px rgba(47,107,255,.13)}

/* ── 加载占位 ── */
.m-loading{text-align:center;padding:20px;color:var(--t3);font-size:12px}
.m-empty{text-align:center;padding:20px 10px;color:var(--t3);font-size:12px}

/* ── 弹窗 ── */
.m-overlay{position:fixed;inset:0;background:rgba(10,22,40,.5);z-index:200;display:flex;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(2px)}
.m-modal{background:#fff;border-radius:16px;max-width:360px;width:100%;max-height:80vh;overflow-y:auto;animation:mFadeIn .2s ease;box-shadow:0 20px 50px rgba(10,22,40,.3)}
@keyframes mFadeIn{from{opacity:0;transform:scale(.95)}to{opacity:1;transform:scale(1)}}
.m-modal-h{padding:14px 16px 10px;font-size:14px;font-weight:600;border-bottom:1px solid #f0f2f6;display:flex;align-items:center;justify-content:space-between}
.m-modal-b{padding:12px 16px 16px}
.m-modal-close{float:right;font-size:18px;cursor:pointer;color:var(--t3);padding:0 4px}

/* ── Toast ── */
.m-toast{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(10,22,40,.92);color:#fff;padding:10px 16px;border-radius:10px;font-size:12px;z-index:300;max-width:260px;text-align:center;animation:mFadeIn .15s ease}

/* ── TabBar ── */
.m-tabbar{position:fixed;bottom:0;left:0;right:0;max-width:480px;margin:0 auto;height:50px;background:#fff;display:flex;box-shadow:0 -1px 4px rgba(0,0,0,.06);z-index:100;border-top:1px solid #f0f0f0}
.m-tabbar a{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-decoration:none;color:var(--t3);font-size:9px;transition:color .15s}
.m-tabbar a.on{color:var(--p)}
.m-tabbar a span{font-size:20px;margin-bottom:1px}
</style>
<!-- BUG-04：复用统一的时区安全格式化助手（App.fmtDT 按 UTC 解析后本地化） -->
<script src="/js/app.js"></script>
</head>
<body class="iphone-host">
<%- include('partials/iphone_frame_start') %>

<!-- ─── 未登录 ─── -->
<% if (!user) { %>
<div class="m-login">
<div class="m-login-box">
<div class="m-login-ico"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3"/><path d="M15 1v3"/><path d="M9 20v3"/><path d="M15 20v3"/><path d="M20 9h3"/><path d="M20 14h3"/><path d="M1 9h3"/><path d="M1 14h3"/></svg></div>
<h2>特种设备AI系统</h2>
<div class="m-login-sub">电梯安全管理 · 移动端</div>
<form method="POST" action="/login">
<input type="email" name="email" placeholder="邮箱" value="admin@demo.com" required>
<input type="password" name="password" placeholder="密码" value="123456" required>
<button type="submit" class="btn-login">登 录</button>
</form>
<% if (error) { %><div class="m-login-err"><%= error %></div><% } %>
<div class="m-login-tip">admin@demo.com · 123456</div>
</div>
</div>

<% } else { %>

<!-- ─── 已登录 ─── -->
<div class="m-shell">
<div class="m-topbar">
<div class="tl"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M8 17V9"/><path d="M13 17V5"/><path d="M18 17v-3"/></svg>仪表盘</div>
<div class="tr"><span id="clock"></span></div>
</div>

<div class="m-content">
<!-- 统计卡片 -->
<div class="m-stats" id="statsGrid">
<div class="m-stat"><div class="sv">-</div><div class="sl">今日判别</div></div>
<div class="m-stat"><div class="sv">-</div><div class="sl">待审核</div></div>
<div class="m-stat"><div class="sv">-</div><div class="sl">活跃模板</div></div>
<div class="m-stat"><div class="sv">-</div><div class="sl">合规率</div></div>
</div>

<!-- 快捷操作 -->
<div class="m-actions">
<a href="/mobile/discriminate" class="m-action-btn"><span class="ico"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 16 3-8 3 8c-2 1.5-4 1.5-6 0"/><path d="m2 16 3-8 3 8c-2 1.5-4 1.5-6 0"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg></span>新建判别</a>
<a href="/mobile/history" class="m-action-btn"><span class="ico"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg></span>判别历史</a>
<a href="/mobile/logs" class="m-action-btn"><span class="ico"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>操作留痕</a>
</div>

<!-- 最近判别 -->
<div class="m-card">
<div class="m-card-h"><span><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>最近判别</span><a href="/mobile/history" class="more">查看全部 →</a></div>
<table class="m-tbl" id="recentTable">
<thead><tr><th style="width:30px">ID</th><th>模板</th><th style="width:52px">结果</th></tr></thead>
<tbody id="recentBody"><tr><td colspan="3" class="m-loading">加载中...</td></tr></tbody>
</table>
</div>
</div>
</div>


<% } %>

<script>
// ── 实时时钟 ──
(function tickClock(){
  var c=document.getElementById('clock');
  if(c){
    var d=new Date();
    var h=d.getHours().toString().padStart(2,'0');
    var m=d.getMinutes().toString().padStart(2,'0');
    var s=d.getSeconds().toString().padStart(2,'0');
    var wd=['日','一','二','三','四','五','六'][d.getDay()];
    c.textContent=(h+':'+m+':'+s);
  }
  setTimeout(tickClock,1000);
})();

// ── 加载仪表盘数据 ──
(function loadDashboard(){
  fetch('/api/dashboard/stats',{credentials:'include'})
    .then(function(r){if(!r.ok)throw Error('网络错误');return r.json()})
    .then(function(d){
      var grid=document.getElementById('statsGrid');
      var cells=grid.querySelectorAll('.sv');
      if(cells[0])cells[0].textContent=d.todayDiscriminations||0;
      if(cells[1]){cells[1].textContent=d.pendingAudits||0;cells[1].className='sv'+(d.pendingAudits>0?' orange':'')}
      if(cells[2])cells[2].textContent=d.activeTemplates||0;
      if(cells[3]){var r=d.compliantRate||'0';cells[3].textContent=r+(String(r).indexOf('%')>=0?'':'%');cells[3].className='sv green'}
    })
    .catch(function(){/*静默失败，保持默认值*/});

  fetch('/api/discrimination-records?page=1',{credentials:'include'})
    .then(function(r){if(!r.ok)throw Error('网络错误');return r.json()})
    .then(function(d){
      var tbody=document.getElementById('recentBody');
      if(!d.data||d.data.length===0){
        tbody.innerHTML='<tr><td colspan="3" class="m-empty">暂无判别记录</td></tr>';
        return;
      }
      tbody.innerHTML=d.data.slice(0,5).map(function(r){
        var cls=r.final_result==='合规'?'ok':r.final_result==='不合规'?'ng':'mb';
        var name=r.template_name||r.templateName||'-';
        if(name.length>10)name=name.substring(0,10)+'…';
        return '<tr><td style="color:var(--t3)">'+(r.id||'-')+'</td>'+
          '<td>'+name+'</td>'+
          '<td><span class="m-tag m-tag-'+cls+'">'+(r.final_result||'-')+'</span></td></tr>';
      }).join('');
    })
    .catch(function(){
      document.getElementById('recentBody').innerHTML='<tr><td colspan="3" class="m-loading" style="color:var(--d)">加载失败</td></tr>';
    });
})();
</script>

<%- include('partials/iphone_frame_end') %>
</body>
</html>
