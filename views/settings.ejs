<%- include('partials/head') %>
<div class="shell">
<%- include('partials/sidebar', {user: user}) %>
<main class="main">
  <%- include('partials/topbar', {user: user, title: '系统设置', crumb: [{label:'系统设置'}]}) %>
  <div class="content">

    <div class="page-hd">
      <div>
        <div class="pt">系统设置</div>
        <div class="pd">查看账号信息、AI 引擎运行状态与系统运行环境</div>
      </div>
      <div class="flex gap-s">
        <a href="/logs" class="btn btn-o">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>
          司法留痕
        </a>
        <a href="/logout" class="btn btn-d">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/></svg>
          退出登录
        </a>
      </div>
    </div>

    <% if (isDefaultPwd) { %>
    <div class="alert danger" style="margin-bottom:16px">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <span>当前账号仍使用默认弱密码 <code>123456</code>，存在被暴力破解风险，请尽快在下方「修改密码」中更换为强密码。</span>
    </div>
    <% } %>

    <div class="grid-2">
      <div class="card">
        <div class="card-h"><div class="ct"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>账号信息</div></div>
        <div class="card-b">
          <div class="kv">
            <span class="k">用户 ID</span><span class="v mono">#<%= (user && user.id) ? user.id : '--' %></span>
            <span class="k">名称</span><span class="v"><%= (user && user.name) ? user.name : '--' %></span>
            <span class="k">邮箱</span><span class="v"><%= (user && user.email) ? user.email : '--' %></span>
            <span class="k">角色</span><span class="v">
              <% var role = user && user.role; %>
              <% if (role === 'admin') { %><span class="tag purple">管理员</span>
              <% } else if (role === 'auditor') { %><span class="tag blue">审核员</span>
              <% } else { %><span class="tag gray">普通用户</span><% } %>
            </span>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-h"><div class="ct"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>AI 引擎状态</div>
          <span class="cs" id="aiState">检测中…</span>
        </div>
        <div class="card-b">
          <div class="kv">
            <span class="k">运行方式</span><span class="v" id="aiMethod">--</span>
            <span class="k">当前模型</span><span class="v mono" id="aiModel">--</span>
            <span class="k">Ollama</span><span class="v" id="aiOllama">--</span>
            <span class="k">Transformers.js</span><span class="v" id="aiTjs">--</span>
          </div>
          <div class="alert info mt" style="margin-bottom:0">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 16v-4m0-4h.01"/></svg>
            <span>AI 仅辅助分析，最终合规结论均由确定性规则引擎给出。</span>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-h"><div class="ct"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>修改密码</div></div>
      <div class="card-b">
        <div class="field"><label>原密码</label><input class="inp" id="pwdOld" type="password" placeholder="请输入当前密码" autocomplete="current-password"></div>
        <div class="field"><label>新密码</label><input class="inp" id="pwdNew" type="password" placeholder="至少8位，含大小写、数字、特殊字符" autocomplete="new-password"></div>
        <div class="field"><label>确认新密码</label><input class="inp" id="pwdNew2" type="password" placeholder="再次输入新密码" autocomplete="new-password"></div>
        <button class="btn btn-p" id="btnPwd" onclick="changePassword()">修改密码</button>
        <span id="pwdMsg" class="muted t-xs" style="margin-left:8px"></span>
      </div>
    </div>

    <div class="card">
      <div class="card-h"><div class="ct"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-2.82 1.17V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 8 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15H4a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 6 8.6a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 11 4.6V4a2 2 0 0 1 4 0v.09A1.65 1.65 0 0 0 19.4 6c.2.6.8 1 1.41 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>系统信息</div></div>
      <div class="card-b">
        <div class="kv">
          <span class="k">系统版本</span><span class="v">4.0.0</span>
          <span class="k">架构</span><span class="v">Node.js + Express + SQLite</span>
          <span class="k">AI 引擎</span><span class="v">本地规则引擎 + AI 辅助分析</span>
          <span class="k">数据库</span><span class="v">SQLite (better-sqlite3)</span>
          <span class="k">渲染引擎</span><span class="v">EJS</span>
          <span class="k">哈希留痕</span><span class="v"><span class="tag ok">已启用</span></span>
        </div>
      </div>
    </div>

  </div>
</main>
</div>

<script>
(function(){
  function tag(ok){ return ok ? '<span class="tag ok">在线</span>' : '<span class="tag gray">未启用</span>'; }
  App.api('/api/ai/status').then(function(d){
    var ai = (d && d.ai) || {};
    document.getElementById('aiMethod').textContent = ai.method || '--';
    document.getElementById('aiModel').textContent = ai.model || '--';
    document.getElementById('aiOllama').innerHTML = tag(!!ai.ollama);
    document.getElementById('aiTjs').innerHTML = tag(!!ai.transformers_js);
    var online = ai.ollama || ai.transformers_js;
    document.getElementById('aiState').textContent = online ? 'AI 辅助在线' : '规则引擎模式';
  }).catch(function(){
    document.getElementById('aiState').textContent = '状态获取失败';
  });
})();

function changePassword(){
  var oldP = document.getElementById('pwdOld').value;
  var newP = document.getElementById('pwdNew').value;
  var newP2 = document.getElementById('pwdNew2').value;
  var msg = document.getElementById('pwdMsg');
  if(!oldP || !newP || !newP2){ msg.textContent='请填写完整'; msg.style.color='var(--danger)'; return; }
  if(newP !== newP2){ msg.textContent='两次输入的新密码不一致'; msg.style.color='var(--danger)'; return; }
  App.api('/api/user/change-password', {method:'POST', body: JSON.stringify({oldPassword: oldP, newPassword: newP})}).then(function(d){
    if(d && d.success){ msg.textContent='密码修改成功，请妥善保管'; msg.style.color='var(--success)'; document.getElementById('pwdOld').value=''; document.getElementById('pwdNew').value=''; document.getElementById('pwdNew2').value=''; }
    else { msg.textContent=(d && d.error) || '修改失败'; msg.style.color='var(--danger)'; }
  }).catch(function(){ msg.textContent='网络错误，请重试'; msg.style.color='var(--danger)'; });
}
</script>
<%- include('partials/foot') %>
