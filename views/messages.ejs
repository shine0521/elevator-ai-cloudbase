<%- include('partials/head') %>
<div class="shell">
<%- include('partials/sidebar', {user: user}) %>
<main class="main">
  <%- include('partials/topbar', {user: user, title: '消息中心', crumb: [{label:'系统与留痕'},{label:'消息中心'}]}) %>
  <div class="content">

    <div class="page-hd">
      <div>
        <div class="pt">消息中心</div>
        <div class="pd">审批 / 预警 / 工单 / 应急 / 系统通知 · 一键已读 · M-17（案例五/六/四联动）</div>
      </div>
      <button class="btn btn-o" onclick="readAll()">全部已读</button>
    </div>

    <div class="stats-row mb" id="sStats">
      <div class="stat tone-red" id="sUn"><div class="sv" id="cntUn">—</div><div class="sl">未读</div></div>
      <div class="stat tone-blue" id="sAp"><div class="sv" id="cntAp">—</div><div class="sl">审批</div></div>
      <div class="stat tone-amber" id="sWa"><div class="sv" id="cntWa">—</div><div class="sl">预警</div></div>
      <div class="stat tone-purple" id="sWo"><div class="sv" id="cntWo">—</div><div class="sl">工单</div></div>
      <div class="stat tone-green" id="sEm"><div class="sv" id="cntEm">—</div><div class="sl">应急</div></div>
    </div>

    <div class="card mb">
      <div class="card-h">
        <div class="ct">消息列表</div>
        <div class="flex gap-s">
          <select class="sel sel-sm" id="fltC">
            <option value="all">全部</option>
            <option value="approval">审批</option>
            <option value="warning">预警</option>
            <option value="workorder">工单</option>
            <option value="emergency">应急</option>
            <option value="system">系统</option>
          </select>
          <button class="btn btn-o btn-sm" onclick="load()">刷新</button>
        </div>
      </div>
      <div class="tbl-wrap"><table class="tbl"><thead><tr><th>状态</th><th>分类</th><th>标题</th><th>内容</th><th>时间</th><th>操作</th></tr></thead><tbody id="tBody"></tbody></table></div>
    </div>

  </div>
</main>
</div>

<script>
(function(){
  function esc(s){ if(s===null||s===undefined) return ''; return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  const CAT_CN = { approval:'审批', warning:'预警', workorder:'工单', emergency:'应急', system:'系统' };
  const CAT_TONE = { approval:'blue', warning:'amber', workorder:'purple', emergency:'green', system:'gray' };

  function loadStats(){
    App.api('/api/mobile/messages/stats').then(function(r){ return r.json(); }).then(function(s){
      if(!s || s.error) return;
      document.getElementById('cntUn').textContent = s.unread || 0;
      document.getElementById('cntAp').textContent = s.approvalUnread || 0;
      document.getElementById('cntWa').textContent = s.warningUnread || 0;
      document.getElementById('cntWo').textContent = s.workorderUnread || 0;
      document.getElementById('cntEm').textContent = s.emergencyUnread || 0;
    }).catch(function(){});
  }

  function load(){
    const c = document.getElementById('fltC').value;
    let url = '/api/mobile/messages?';
    if(c && c !== 'all') url += 'category=' + encodeURIComponent(c) + '&';
    App.api(url).then(function(r){ return r.json(); }).then(function(res){
      const list = (res && res.data) || [];
      const tb = document.getElementById('tBody');
      if(!list.length){ tb.innerHTML = '<tr><td colspan="6" class="center-t soft">暂无消息</td></tr>'; return; }
      tb.innerHTML = list.map(function(m){
        const tone = CAT_TONE[m.category] || 'gray';
        const readTag = m.is_read ? '<span class="tag tone-gray">已读</span>' : '<span class="tag tone-red">未读</span>';
        const ops = m.is_read
          ? '<button class="btn btn-o btn-sm" onclick="delMsg(' + m.id + ')">删除</button>'
          : '<button class="btn btn-o btn-sm" onclick="markRead(' + m.id + ')">已读</button> <button class="btn btn-o btn-sm" onclick="delMsg(' + m.id + ')">删除</button>';
        return '<tr>'
          + '<td>' + readTag + '</td>'
          + '<td><span class="tag tone-' + tone + '">' + (CAT_CN[m.category] || m.category) + '</span></td>'
          + '<td>' + esc(m.title) + '</td>'
          + '<td class="soft t-xs">' + esc(m.content || '') + '</td>'
          + '<td class="soft t-xs">' + esc(m.created_at) + '</td>'
          + '<td>' + ops + '</td>'
          + '</tr>';
      }).join('');
    }).catch(function(){});
  }

  window.load = load;
  window.markRead = function(id){
    App.api('/api/mobile/messages/' + id + '/read', { method:'POST' }).then(function(r){ return r.json(); }).then(function(res){
      if(res.success){ load(); loadStats(); }
    }).catch(function(){});
  };
  window.readAll = function(){
    App.api('/api/mobile/messages/read-all', { method:'POST', body: JSON.stringify({}) }).then(function(r){ return r.json(); }).then(function(res){
      if(res.success){ load(); loadStats(); }
    }).catch(function(){});
  };
  window.delMsg = function(id){
    if(!confirm('确认删除该消息？')) return;
    App.api('/api/mobile/messages/' + id, { method:'DELETE' }).then(function(r){ return r.json(); }).then(function(res){
      if(res.success){ load(); loadStats(); }
    }).catch(function(){});
  };

  load(); loadStats();
})();
</script>
